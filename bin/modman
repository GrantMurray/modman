#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
TOOLS_DIR="${ROOT_DIR}/tools"
INDEX_FILE="${ROOT_DIR}/data/index.txt"
HISTORY_FILE="${ROOT_DIR}/data/.modman_history"
MINECRAFT_ROOT="/srv/minecraft"
SYSTEMD_SERVICE="mc-servers.service"
SYSTEMD_UNIT="/etc/systemd/system/${SYSTEMD_SERVICE}"
SYSTEMD_HELPER="/usr/local/bin/start_mc_servers"
WEB_PORT=8787
WEB_HTTP_PORT=8788
WEB_STATE_FILE="${ROOT_DIR}/data/.modman-web.state"
WEB_LOG_FILE="${ROOT_DIR}/data/.modman-web.log"
WEB_SERVICE_STATE_FILE="${ROOT_DIR}/data/.modman-service-state"
WEB_PY="${TOOLS_DIR}/modman-web.py"
WEB_SYSTEMD_SERVICE="modman-web.service"
WEB_SYSTEMD_UNIT="/etc/systemd/system/${WEB_SYSTEMD_SERVICE}"
WEB_SYSTEMD_HELPER="/usr/local/bin/modman-web"
WEB_HASH_FILE="${ROOT_DIR}/data/.modman-web-hash"
WEB_CERT_FILE="${ROOT_DIR}/data/.modman-web-cert.pem"
WEB_KEY_FILE="${ROOT_DIR}/data/.modman-web-key.pem"
WEB_CA_FILE="${ROOT_DIR}/data/.modman-web-ca.pem"
WEB_CA_KEY_FILE="${ROOT_DIR}/data/.modman-web-ca-key.pem"
WEB_DOMAIN_FILE="${ROOT_DIR}/data/.modman-web-domain"
CF_CANCELLED=0

usage() {
	cat <<EOF
Usage: $(basename "$0")
       $(basename "$0") --web ACTION
       $(basename "$0") -w ACTION

Interactive modpack manager for ${SYSTEMD_SERVICE} (via index.txt).
Type commands at the prompt; type exit to leave.

--web and -w run one webpage command, then exit. ACTION is start, stop, restart, status, enable, disable, or install.

Status values (STATUS column only — start/stop/restart use live screen presence):
  stopped                    No live screen session
  starting                   Screen is up; server has not printed Done yet
  running                    Screen is up and startup finished (Done (Xs)!)
  error                      Screen is up, but the server crashed or hit an error

Commands:
  list                       Display all modpacks in /srv/minecraft
  status [MODPACK]           Show running/stopped state (all indexed, or one pack)
  usage [MODPACK]            Show CPU, RAM, and uptime (all indexed, or one pack)
  start [MODPACK]            Start a stopped pack, or all stopped indexed packs
  stop [MODPACK]             Stop a running pack, or all indexed packs
  restart [MODPACK]          Restart a pack, or all indexed packs
  join MODPACK               Attach to a pack's screen (detach with Ctrl-A d)
  service status             Show ${SYSTEMD_SERVICE} status
  service start              Start ${SYSTEMD_SERVICE} (starts missing indexed packs)
  service stop               Stop all indexed packs and ${SYSTEMD_SERVICE}
  service restart            Restart all indexed packs via ${SYSTEMD_SERVICE}
  service enable             Enable ${SYSTEMD_SERVICE} to start at boot
  service disable            Disable ${SYSTEMD_SERVICE} from starting at boot
  service install            Install ${SYSTEMD_SERVICE} to run as the current user
  install                    Search CurseForge and install a server pack
  update MODPACK             Install a newer CurseForge server pack into an existing folder
  enable MODPACK             Put a pack in the index so it starts with the others
  disable MODPACK            Stop a running pack (if needed), then take it out of the index
  uninstall MODPACK          Ask, then delete the pack folder from disk
  rename OLD NEW             Rename a modpack dir and update the index if present
  port MODPACK PORT          Set a modpack's server-port in server.properties
  web start                  Start https and http with the saved password
  web stop                   Stop the control page
  web restart                Stop the page, then start it again
  web status                 Show the control page link when it is running
  web password               Set or change the webpage password
  web pswd                   Set or change the webpage password
  web enable                 Enable the webpage service to start at boot
  web disable                Disable the webpage service from starting at boot
  web install                Install the webpage service for the current user
  help                       Show this help
  exit                       Leave the manager

History:
  Up/Down arrows             Recall previously executed commands
  Tab                        Complete commands and modpack names

Examples:
  list
  status
  usage
  usage Cobbleverse
  start Cobbleverse
  stop Cobbleverse
  join Cobbleverse
  restart
  service restart
  service enable
  service install
  install
  update Cobbleverse
  enable Ascendra
  disable Linggango
  uninstall Linggango
  rename MonkeyMine MonkeyMine2
  port Cobbleverse 25570
  web start
  web status
  web stop
  web restart
  web password
  web install
  web enable
  web disable

From the shell:
  $(basename "$0") --web start
  $(basename "$0") -w status
  $(basename "$0") --web restart
  $(basename "$0") -w stop
  $(basename "$0") --web install
  $(basename "$0") -w enable
EOF
}

ensure_index() {
	touch "$INDEX_FILE"
}

read_index() {
	ensure_index
	mapfile -t INDEX_ENTRIES < <(grep -v '^[[:space:]]*$' "$INDEX_FILE" || true)
}

in_index() {
	local name="$1"
	local entry
	for entry in "${INDEX_ENTRIES[@]+"${INDEX_ENTRIES[@]}"}"; do
		[[ "$entry" == "$name" ]] && return 0
	done
	return 1
}

write_index() {
	if ((${#INDEX_ENTRIES[@]})); then
		printf '%s\n' "${INDEX_ENTRIES[@]}" >"$INDEX_FILE"
	else
		: >"$INDEX_FILE"
	fi
}

get_port() {
	local name="$1"
	if ! pack_stays_inside "$name"; then
		printf '%s' "-"
		return 0
	fi
	local props="$MINECRAFT_ROOT/$name/server.properties"
	local port=""

	if [[ -f "$props" ]]; then
		port="$(grep -E '^[[:space:]]*server-port=' "$props" 2>/dev/null | head -n1 | cut -d= -f2- | tr -d '[:space:]')"
	fi

	if [[ -n "$port" ]]; then
		printf '%s' "$port"
	else
		printf '%s' "-"
	fi
}

# Java executable a pack's start.sh launches: a literal java command, or JAVA= from variables.txt.
java_bin_for() {
	local name="$1"
	if ! pack_stays_inside "$name"; then
		return 0
	fi
	local start="$MINECRAFT_ROOT/$name/start.sh"
	local vars="$MINECRAFT_ROOT/$name/variables.txt"
	local bin="" line

	if [[ -f "$start" ]]; then
		line="$(grep -E "^[[:space:]]*(exec[[:space:]]+)?['\"]?(/[^[:space:]'\"]*/java|java)['\"]?([[:space:]]|\$)" "$start" | head -n1 || true)"
		line="${line#"${line%%[![:space:]]*}"}"
		if [[ "$line" == exec[[:space:]]* ]]; then
			line="${line#exec}"
			line="${line#"${line%%[![:space:]]*}"}"
		fi
		bin="${line%%[[:space:]]*}"
		# Generated scripts quote the java path.
		bin="${bin//\'/}"
		bin="${bin//\"/}"
	fi

	if [[ -z "$bin" && -f "$vars" ]]; then
		line="$(grep -E '^[[:space:]]*JAVA=' "$vars" | head -n1 || true)"
		line="${line#*=}"
		line="${line#"${line%%[![:space:]]*}"}"
		line="${line%"${line##*[![:space:]]}"}"
		if [[ "$line" == \"*\" || "$line" == \'*\' ]]; then
			line="${line:1:${#line}-2}"
		fi
		bin="$line"
	fi

	printf '%s' "$bin"
}

# Major version of the Java binary that pack would start (8, 17, 21, …), or "-".
get_java_version() {
	local name="$1"
	local bin version major

	bin="$(java_bin_for "$name")"
	if [[ "$bin" != "java" && "$bin" != /*/java ]]; then
		printf '%s' "-"
		return 0
	fi

	if [[ ! -v JAVA_VERSION_CACHE ]]; then
		declare -gA JAVA_VERSION_CACHE=()
	fi
	if [[ -v "JAVA_VERSION_CACHE[$bin]" ]]; then
		printf '%s' "${JAVA_VERSION_CACHE[$bin]}"
		return 0
	fi

	version="$("$bin" -version 2>&1 || true)"
	version="$(printf '%s\n' "$version" | awk -F'"' '/version/ { print $2; exit }')"
	if [[ "$version" == 1.* ]]; then
		major="${version#1.}"
		major="${major%%.*}"
	else
		major="${version%%.*}"
	fi
	if [[ ! "$major" =~ ^[0-9]+$ ]]; then
		major="-"
	fi
	JAVA_VERSION_CACHE["$bin"]="$major"
	printf '%s' "$major"
}

screen_name() {
	printf 'mc-%s' "$1"
}

# Operational up/down check: live screen session only.
# "starting" vs "running" is display-only (see display_status); never branch
# control flow on boot completion — a booting pack is still "up".
is_running() {
	local name="$1"
	local session
	session="$(screen_name "$name")"

	# Do not screen -wipe here. A status refresh runs this often, and wipe
	# can remove a live session that is busy, which closes the server console.
	screen -ls 2>/dev/null | grep -E "\.${session}[[:space:]]" | grep -vq 'Dead'
}

# Display helper only. Prints starting, running, or error from latest.log.
# A new boot line clears an earlier crash in the same file.
_log_boot_state() {
	local name="$1"
	local log
	if ! pack_stays_inside "$name"; then
		printf '%s' "starting"
		return 0
	fi
	log="$MINECRAFT_ROOT/$name/logs/latest.log"
	if [[ ! -f "$log" ]]; then
		printf '%s' "starting"
		return 0
	fi
	awk '
		/Loading Minecraft .* with Fabric Loader/ { crashed = 0; ready = 0 }
		/Starting minecraft server version/ { crashed = 0; ready = 0 }
		/Done \([0-9.]+s\)!/ { if (!crashed) ready = 1 }
		/Encountered an unexpected exception/ { crashed = 1; ready = 0 }
		/Preparing crash report/ { crashed = 1; ready = 0 }
		/This crash report has been saved/ { crashed = 1; ready = 0 }
		/Failed to start the minecraft server/ { crashed = 1; ready = 0 }
		/A fatal error has been detected by the Java Runtime/ { crashed = 1; ready = 0 }
		END {
			if (crashed) print "error"
			else if (ready) print "running"
			else print "starting"
		}
	' "$log"
}

# True when this pack's folder is the working directory of a java process.
pack_java_running() {
	local name="$1"
	local pack_dir pid cwd comm
	if ! pack_stays_inside "$name"; then
		return 1
	fi
	pack_dir="$MINECRAFT_ROOT/$name"
	for pid in /proc/[0-9]*; do
		pid="${pid#/proc/}"
		cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
		[[ "$cwd" == "$pack_dir" ]] || continue
		comm="$(cat "/proc/$pid/comm" 2>/dev/null || true)"
		[[ "$comm" == "java" ]] && return 0
	done
	return 1
}

# Display-only STATUS label. Control logic must use is_running, not this.
display_status() {
	local name="$1"
	local state
	if ! is_running "$name"; then
		printf '%s' "stopped"
		return 0
	fi
	state="$(_log_boot_state "$name")"
	# The screen can outlive the server. Done was printed, then java exited.
	if [[ "$state" == "running" ]] && ! pack_java_running "$name"; then
		state="error"
	fi
	printf '%s' "$state"
}

# Color when stdout is a terminal.
color_enabled() {
	[[ -t 1 ]]
}

# Print a left-padded status word; red/yellow/green when color is enabled.
print_status_cell() {
	local status="$1"
	local padded
	padded="$(printf '%-8s' "$status")"

	if ! color_enabled; then
		printf '%s' "$padded"
		return
	fi

	case "$status" in
		stopped)
			printf '\033[31m%s\033[0m' "$padded"
			;;
		starting)
			printf '\033[33m%s\033[0m' "$padded"
			;;
		running)
			printf '\033[32m%s\033[0m' "$padded"
			;;
		error)
			printf '\033[91m%s\033[0m' "$padded"
			;;
		*)
			printf '%s' "$padded"
			;;
	esac
}

print_pack_row() {
	local name="$1"
	local width="$2"
	local with_status="${3:-0}"
	local highlight="${4:-0}"
	local port java left

	port="$(get_port "$name")"
	java="$(get_java_version "$name")"

	if ((with_status)); then
		left="$(printf "%-${width}s  %-4s  %-7s  " "$name" "$java" "$port")"
		# Port conflicts: paint name/port red; status keeps its own color.
		if ((highlight)) && color_enabled; then
			printf '\033[31m%s\033[0m' "$left"
		else
			printf '%s' "$left"
		fi
		print_status_cell "$(display_status "$name")"
		printf '\n'
	else
		left="$(printf "%-${width}s  %-4s  %s" "$name" "$java" "$port")"
		if ((highlight)) && color_enabled; then
			printf '\033[31m%s\033[0m\n' "$left"
		else
			printf '%s\n' "$left"
		fi
	fi
}

# Populate CONFLICT_PORTS assoc array (port -> 1) for ports used by 2+ packs.
# Ignores missing ports ("-"). Sets CONFLICT_COUNT for set -u-safe checks.
build_port_conflicts() {
	unset CONFLICT_PORTS 2>/dev/null || true
	declare -gA CONFLICT_PORTS
	CONFLICT_COUNT=0
	local -A counts=()
	local name port

	for name in "$@"; do
		port="$(get_port "$name")"
		[[ "$port" == "-" ]] && continue
		counts["$port"]=$((${counts["$port"]:-0} + 1))
	done

	for port in "${!counts[@]}"; do
		if ((counts["$port"] > 1)); then
			CONFLICT_PORTS["$port"]=1
			CONFLICT_COUNT=$((CONFLICT_COUNT + 1))
		fi
	done
}

port_conflicts() {
	local port="$1"
	[[ "$port" != "-" ]] || return 1
	((CONFLICT_COUNT > 0)) || return 1
	[[ -n "${CONFLICT_PORTS[$port]:-}" ]]
}

print_port_conflict_warning() {
	((CONFLICT_COUNT > 0)) || return 0

	local msg="Warning: overlapping ports detected; conflicting modpacks will not start properly."
	if color_enabled; then
		printf '\033[31m%s\033[0m\n' "$msg" >&2
	else
		printf '%s\n' "$msg" >&2
	fi
}

# Header row plus a rule the same width, so column names stay distinct from the rows.
print_table_header() {
	local header="$1"
	local dashes
	printf '%s\n' "$header"
	dashes="$(printf '%*s' "${#header}" '')"
	printf '%s\n' "${dashes// /-}"
}

print_indexed_status_table() {
	local width
	width="$(max_name_width "${INDEX_ENTRIES[@]}")"
	build_port_conflicts "${INDEX_ENTRIES[@]}"

	print_table_header "$(printf "%-${width}s  %-4s  %-7s  %-8s" "MODPACK" "JAVA" "PORT" "STATUS")"
	local name port highlight
	for name in "${INDEX_ENTRIES[@]}"; do
		port="$(get_port "$name")"
		highlight=0
		if port_conflicts "$port"; then
			highlight=1
		fi
		print_pack_row "$name" "$width" 1 "$highlight"
	done
	print_port_conflict_warning
}

max_name_width() {
	local width=0
	local name
	for name in "$@"; do
		if ((${#name} > width)); then
			width=${#name}
		fi
	done
	# Keep at least as wide as the "MODPACK" header.
	if ((width < 7)); then
		width=7
	fi
	printf '%s' "$width"
}

list_index() {
	read_index
	if ((${#INDEX_ENTRIES[@]} == 0)); then
		echo "Index is empty: $INDEX_FILE"
	else
		echo "Indexed modpacks ($INDEX_FILE):"
		print_indexed_status_table
	fi

	local names=()
	local dir name width
	for dir in "$MINECRAFT_ROOT"/*/; do
		[[ -d "$dir" ]] || continue
		name="$(basename "$dir")"
		[[ "$name" == *.bak ]] && continue
		if ! in_index "$name"; then
			names+=("$name")
		fi
	done
	if ((${#names[@]} == 0)); then
		return 0
	fi

	echo
	echo "Not in the index:"
	width="$(max_name_width "${names[@]}")"
	print_table_header "$(printf "%-${width}s  %-4s  %s" "MODPACK" "JAVA" "PORT")"
	for name in "${names[@]}"; do
		print_pack_row "$name" "$width"
	done
}

add_modpack() {
	local name="${1:-}"
	if [[ -z "$name" ]]; then
		echo "Error: missing modpack name." >&2
		return 1
	fi
	require_modpack "$name" || return 1

	local pack_dir="$MINECRAFT_ROOT/$name"
	if [[ ! -d "$pack_dir" ]]; then
		echo "Error: '$name' not found under $MINECRAFT_ROOT" >&2
		return 1
	fi
	if [[ ! -x "$pack_dir/start.sh" && ! -f "$pack_dir/start.sh" ]]; then
		echo "Error: '$name' has no start.sh" >&2
		return 1
	fi

	read_index
	if in_index "$name"; then
		echo "'$name' is already in the index."
		return 0
	fi

	INDEX_ENTRIES+=("$name")
	write_index
	echo "Enabled '$name' in $INDEX_FILE"
}

remove_modpack() {
	local name="${1:-}"
	if [[ -z "$name" ]]; then
		echo "Error: missing modpack name." >&2
		return 1
	fi
	require_modpack "$name" || return 1

	read_index
	if ! in_index "$name"; then
		echo "Error: '$name' is not in the index." >&2
		return 1
	fi

	# Stop before dropping from the index so the pack is not left orphaned.
	if is_running "$name"; then
		stop_one "$name" || return 1
	fi

	local updated=()
	local entry
	for entry in "${INDEX_ENTRIES[@]}"; do
		[[ "$entry" == "$name" ]] && continue
		updated+=("$entry")
	done
	INDEX_ENTRIES=("${updated[@]+"${updated[@]}"}")
	write_index
	echo "Disabled '$name' in $INDEX_FILE"
}

uninstall_modpack() {
	local name="${1:-}"
	local dest answer
	local running=0 indexed=0
	if [[ -z "$name" ]]; then
		echo "Error: missing modpack name." >&2
		return 1
	fi
	require_modpack "$name" || return 1

	dest="${MINECRAFT_ROOT}/${name}"
	if [[ -L "$dest" ]]; then
		echo "Error: '$dest' is a symlink." >&2
		return 1
	fi
	if [[ ! -d "$dest" ]]; then
		echo "Error: '$name' not found under $MINECRAFT_ROOT" >&2
		return 1
	fi

	read_index
	if is_running "$name"; then
		running=1
	fi
	if in_index "$name"; then
		indexed=1
	fi

	echo "Delete ${dest}, including its world?"
	if ((running)); then
		echo "The server is running and will be stopped first."
	fi
	if ((indexed)); then
		echo "It will also be taken out of the index."
	fi
	if [[ "${MODMAN_YES:-}" == "1" ]]; then
		answer=yes
	elif ! read -r -e -p "Type yes to confirm: " answer; then
		echo
		return 1
	fi
	if [[ "${answer,,}" != "yes" ]]; then
		echo "Cancelled."
		return 0
	fi

	if ((running)); then
		stop_one "$name" || return 1
	fi
	if ((indexed)); then
		local updated=()
		local entry
		for entry in "${INDEX_ENTRIES[@]}"; do
			[[ "$entry" == "$name" ]] && continue
			updated+=("$entry")
		done
		INDEX_ENTRIES=("${updated[@]+"${updated[@]}"}")
		write_index
	fi
	if ! rm -rf "$dest"; then
		echo "Error: failed to delete $dest" >&2
		return 1
	fi
	echo "Uninstalled '$name' (${dest})"
}

valid_modpack_name() {
	local name="$1"
	# One directory name. ".." anywhere, slashes, and shell metacharacters
	# would let a path leave MINECRAFT_ROOT.
	[[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
	[[ "$name" != "." && "$name" != ".." ]] || return 1
	[[ "$name" != *..* ]] || return 1
	return 0
}

# True when name is a safe folder name and, if it exists, resolves to a
# direct child of MINECRAFT_ROOT. Symlinks fail this check.
pack_stays_inside() {
	local name="$1"
	local root dest real_root real_dest
	valid_modpack_name "$name" || return 1
	root="${MINECRAFT_ROOT%/}"
	dest="${root}/${name}"
	[[ -L "$dest" ]] && return 1
	if [[ -e "$dest" ]]; then
		real_root="$(realpath -e "$root" 2>/dev/null)" || return 1
		real_dest="$(realpath -e "$dest" 2>/dev/null)" || return 1
		[[ "$real_dest" == "$real_root/$name" ]] || return 1
	fi
	return 0
}

require_modpack() {
	local name="$1"
	if ! valid_modpack_name "$name"; then
		echo "Error: '$name' is not a modpack name." >&2
		return 1
	fi
	if ! pack_stays_inside "$name"; then
		echo "Error: '$name' is outside $MINECRAFT_ROOT." >&2
		return 1
	fi
	return 0
}

rename_modpack() {
	local old="${1:-}"
	local new="${2:-}"

	if [[ -z "$old" || -z "$new" ]]; then
		echo "Error: rename requires OLD and NEW names." >&2
		return 1
	fi

	require_modpack "$old" || return 1
	require_modpack "$new" || return 1

	if [[ "$old" == "$new" ]]; then
		echo "'$old' is already named '$new'."
		return 0
	fi

	local old_dir="$MINECRAFT_ROOT/$old"
	local new_dir="$MINECRAFT_ROOT/$new"

	if [[ ! -d "$old_dir" ]]; then
		echo "Error: '$old' not found under $MINECRAFT_ROOT" >&2
		return 1
	fi
	if [[ -e "$new_dir" ]]; then
		echo "Error: '$new' already exists under $MINECRAFT_ROOT" >&2
		return 1
	fi

	read_index
	if in_index "$new"; then
		echo "Error: '$new' is already in the index." >&2
		return 1
	fi

	local was_running=0
	if is_running "$old"; then
		was_running=1
		stop_one "$old" || return 1
	fi

	if ! mv "$old_dir" "$new_dir"; then
		echo "Error: failed to rename '$old' to '$new' (permission denied?)." >&2
		# Best-effort restart under the old name if we stopped it.
		if ((was_running)); then
			start_one "$old" || true
		fi
		return 1
	fi

	local indexed=0
	if in_index "$old"; then
		indexed=1
		local updated=()
		local entry
		for entry in "${INDEX_ENTRIES[@]}"; do
			if [[ "$entry" == "$old" ]]; then
				updated+=("$new")
			else
				updated+=("$entry")
			fi
		done
		INDEX_ENTRIES=("${updated[@]}")
		write_index
	fi

	if ((indexed)); then
		echo "Renamed '$old' to '$new' and updated $INDEX_FILE"
	else
		echo "Renamed '$old' to '$new' (not in index)"
	fi

	if ((was_running)); then
		start_one "$new" || return 1
	fi
}

set_port() {
	local name="${1:-}"
	local port="${2:-}"

	if [[ -z "$name" || -z "$port" ]]; then
		echo "Error: port requires MODPACK and PORT." >&2
		return 1
	fi
	require_modpack "$name" || return 1

	local pack_dir="$MINECRAFT_ROOT/$name"
	if [[ ! -d "$pack_dir" ]]; then
		echo "Error: '$name' not found under $MINECRAFT_ROOT" >&2
		return 1
	fi

	if [[ ! "$port" =~ ^[0-9]+$ ]] || ((port < 1 || port > 65535)); then
		echo "Error: port must be an integer between 1 and 65535." >&2
		return 1
	fi

	local props="$pack_dir/server.properties"
	local old_port
	old_port="$(get_port "$name")"

	if [[ -f "$props" ]] && grep -qE '^[[:space:]]*server-port=' "$props"; then
		local tmp
		tmp="$(mktemp)"
		sed -E "s/^[[:space:]]*server-port=.*/server-port=${port}/" "$props" >"$tmp"
		if ! cat "$tmp" >"$props"; then
			rm -f "$tmp"
			echo "Error: failed to write $props (permission denied?)." >&2
			return 1
		fi
		rm -f "$tmp"
	else
		if ! printf 'server-port=%s\n' "$port" >>"$props"; then
			echo "Error: failed to write $props (permission denied?)." >&2
			return 1
		fi
	fi

	if [[ "$old_port" == "-" ]]; then
		echo "Set '$name' server-port to $port ($props)"
	else
		echo "Changed '$name' server-port from $old_port to $port ($props)"
	fi
}

show_status() {
	local name="${1:-}"

	if [[ -n "$name" ]]; then
		require_modpack "$name" || return 1
		if [[ ! -d "$MINECRAFT_ROOT/$name" ]]; then
			echo "Error: '$name' not found under $MINECRAFT_ROOT" >&2
			return 1
		fi
		local width
		width="$(max_name_width "$name")"
		print_table_header "$(printf "%-${width}s  %-4s  %-7s  %-8s" "MODPACK" "JAVA" "PORT" "STATUS")"
		print_pack_row "$name" "$width" 1
		return 0
	fi

	read_index
	if ((${#INDEX_ENTRIES[@]} == 0)); then
		echo "Index is empty: $INDEX_FILE"
		return 0
	fi

	print_indexed_status_table
}

format_ram_kb() {
	local kb="$1"
	local tenths
	tenths=$((kb * 10 / 1048576))
	printf '%d.%d GB' $((tenths / 10)) $((tenths % 10))
}

format_elapsed() {
	local etime="$1"
	local days=0 hours=0 mins=0 secs=0
	local a b c

	if [[ "$etime" == *-* ]]; then
		days="${etime%%-*}"
		etime="${etime#*-}"
	fi
	IFS=: read -r a b c <<<"$etime"
	if [[ -z "${c:-}" ]]; then
		mins=$((10#$a))
		secs=$((10#$b))
	else
		hours=$((10#$a))
		mins=$((10#$b))
		secs=$((10#$c))
	fi

	if ((days > 0)); then
		printf '%dd %dh' "$days" "$hours"
	elif ((hours > 0)); then
		printf '%dh %dm' "$hours" "$mins"
	elif ((mins > 0)); then
		printf '%d min' "$mins"
	else
		printf '%ds' "$secs"
	fi
}

# CPU, RAM, and uptime of the pack's Java process. "-" when it is not running.
# CPU, RAM, and uptime for every pack with a running java process, from one
# pass over /proc and one ps call. Fills the associative array named by $1 with
# name -> "cpu<TAB>ram<TAB>uptime". Packs with no java process are left out.
collect_pack_usage() {
	local -n usage_out="$1"
	local name pid pcpu rss etime list
	local -A pids=() by_pid=()

	while IFS=$'\t' read -r name pid; do
		[[ -n "$name" && -z "${pids[$name]:-}" ]] && pids["$name"]="$pid"
	done < <(python3 - "$MINECRAFT_ROOT" <<'PY'
import os, sys
root = os.path.normpath(sys.argv[1])
# Lexical order, as the old /proc/[0-9]* glob walked it.
for pid in sorted(os.listdir("/proc")):
    if not pid.isdigit():
        continue
    try:
        cwd = os.readlink(f"/proc/{pid}/cwd")
        with open(f"/proc/{pid}/comm") as fh:
            comm = fh.read().strip()
    except OSError:
        continue
    if comm != "java":
        continue
    parent, name = os.path.split(cwd)
    if parent == root and name and "\t" not in name and "\n" not in name:
        print(f"{name}\t{pid}")
PY
	)
	((${#pids[@]})) || return 0

	for name in "${!pids[@]}"; do
		by_pid["${pids[$name]}"]="$name"
	done
	list="$(IFS=,; printf '%s' "${pids[*]}")"
	while read -r pid pcpu rss etime; do
		name="${by_pid[$pid]:-}"
		[[ -n "$name" ]] || continue
		usage_out["$name"]="$(printf '%.1f%%' "$pcpu")"$'\t'"$(format_ram_kb "$rss")"$'\t'"$(format_elapsed "$etime")"
	done < <(ps -o pid=,pcpu=,rss=,etime= -p "$list" 2>/dev/null || true)
}

print_usage_table() {
	local width
	width="$(max_name_width "$@")"
	print_table_header "$(printf "%-${width}s  %-6s  %-8s  %s" "MODPACK" "CPU" "RAM" "UPTIME")"
	local name cpu ram uptime
	local -A usage=()
	collect_pack_usage usage
	for name in "$@"; do
		cpu="-"
		ram="-"
		uptime="-"
		if [[ -n "${usage[$name]:-}" ]] && pack_stays_inside "$name"; then
			IFS=$'\t' read -r cpu ram uptime <<<"${usage[$name]}"
		fi
		printf "%-${width}s  %-6s  %-8s  %s\n" "$name" "$cpu" "$ram" "$uptime"
	done
}

show_usage() {
	local name="${1:-}"

	if [[ -n "$name" ]]; then
		require_modpack "$name" || return 1
		if [[ ! -d "$MINECRAFT_ROOT/$name" ]]; then
			echo "Error: '$name' not found under $MINECRAFT_ROOT" >&2
			return 1
		fi
		print_usage_table "$name"
		return 0
	fi

	read_index
	if ((${#INDEX_ENTRIES[@]} == 0)); then
		echo "Index is empty: $INDEX_FILE"
		return 0
	fi

	print_usage_table "${INDEX_ENTRIES[@]}"
}

# The webpage service kills every process in its control group when it
# restarts. A screen started there dies with it. The user service manager
# is outside that group, so the screen keeps running.
launch_server_screen() {
	local name="$1"
	local session="$2"
	local pack_dir="$3"
	local unit runtime bus quoted

	if ! command -v systemd-run >/dev/null 2>&1; then
		echo "Error: systemd-run is not installed, so '$name' was not started." >&2
		return 1
	fi
	runtime="/run/user/$(id -u)"
	bus="$runtime/bus"
	if [[ ! -S "$bus" ]]; then
		echo "Error: the user service is not running, so '$name' was not started." >&2
		return 1
	fi

	unit="modman-${session}"
	XDG_RUNTIME_DIR="$runtime"
	DBUS_SESSION_BUS_ADDRESS="unix:path=${bus}"
	export XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS
	systemctl --user reset-failed "${unit}.service" >/dev/null 2>&1 || true

	quoted="$(printf '%q' "$pack_dir")"
	systemd-run --user --collect --quiet \
		--expand-environment=no \
		--unit="$unit" \
		--property=Type=exec \
		--description="Minecraft server ${name}" \
		-- \
		screen -DmS "$session" bash -c "cd ${quoted} && ./start.sh" \
		|| return 1
}

MINECRAFT_EULA_URL="https://aka.ms/MinecraftEULA"

# True when the pack's eula.txt has eula=true.
eula_accepted() {
	local pack_dir="$1"
	[[ -f "$pack_dir/eula.txt" ]] &&
		grep -qiE '^[[:space:]]*eula[[:space:]]*=[[:space:]]*true[[:space:]]*$' "$pack_dir/eula.txt"
}

eula_terms() {
	local name="$1"
	cat <<EOF
'${name}' needs the Minecraft End User License Agreement (EULA) accepted before it can start.
The full terms are at ${MINECRAFT_EULA_URL}
By agreeing, you are indicating your agreement to the Minecraft EULA, and eula=true is written to ${name}/eula.txt.
EOF
}

# Write eula=true, keeping any other lines in the file.
accept_eula() {
	local pack_dir="$1"
	local file="$pack_dir/eula.txt"
	if [[ -f "$file" ]] && grep -qiE '^[[:space:]]*eula[[:space:]]*=' "$file"; then
		sed -i -E 's/^[[:space:]]*eula[[:space:]]*=.*/eula=true/I' "$file" || return 1
	else
		{
			printf '#By changing the setting below to TRUE you are indicating your agreement to our EULA (%s).\n' "$MINECRAFT_EULA_URL"
			printf '#%s\n' "$(date)"
			printf 'eula=true\n'
		} >>"$file" || return 1
	fi
}

# Make sure the EULA is accepted before a start. Asks at the prompt; a web call
# passes MODMAN_EULA=agree once the user agreed on the page.
# Returns 0 when accepted, 3 when it was not.
ensure_eula() {
	local name="$1"
	local pack_dir="$MINECRAFT_ROOT/$name"
	local answer

	if eula_accepted "$pack_dir"; then
		return 0
	fi
	if [[ "${MODMAN_EULA:-}" != "agree" ]]; then
		eula_terms "$name"
		if [[ -n "${MODMAN_WEB_CALL:-}" || ! -t 0 ]]; then
			echo "Not started: the EULA has not been accepted."
			return 3
		fi
		if ! read -r -e -p "Do you agree to the Minecraft EULA? Type yes to agree: " answer; then
			echo
			answer=""
		fi
		if [[ "${answer,,}" != "yes" ]]; then
			echo "Not started: the EULA was not accepted."
			return 3
		fi
	fi
	if ! accept_eula "$pack_dir"; then
		echo "Error: failed to write $pack_dir/eula.txt" >&2
		return 1
	fi
	echo "EULA accepted for '$name'."
}

start_one() {
	local name="$1"
	require_modpack "$name" || return 1
	local pack_dir="$MINECRAFT_ROOT/$name"
	local session
	session="$(screen_name "$name")"

	if [[ ! -d "$pack_dir" ]]; then
		echo "Error: '$name' not found under $MINECRAFT_ROOT" >&2
		return 1
	fi
	if [[ ! -f "$pack_dir/start.sh" ]]; then
		echo "Error: '$name' has no start.sh" >&2
		return 1
	fi

	if is_running "$name"; then
		echo "'$name' is already running (screen $session)."
		return 0
	fi

	# Drop a leftover dead socket so it does not block the new session.
	screen -wipe >/dev/null 2>&1 || true
	if is_running "$name"; then
		echo "'$name' is already running (screen $session)."
		return 0
	fi

	ensure_eula "$name" || return

	if [[ -n "${MODMAN_WEB_CALL:-}" ]]; then
		launch_server_screen "$name" "$session" "$pack_dir" || return 1
	else
		screen -dmS "$session" bash -c "cd \"$pack_dir\" && ./start.sh"
	fi
	echo "Started '$name' in screen $session."
}

start_servers() {
	local name="${1:-}"

	if [[ -n "$name" ]]; then
		start_one "$name"
		return
	fi

	read_index
	if ((${#INDEX_ENTRIES[@]} == 0)); then
		echo "Index is empty: $INDEX_FILE"
		return 0
	fi

	local started=0
	local skipped=0
	local no_eula=0
	local entry status
	for entry in "${INDEX_ENTRIES[@]}"; do
		if is_running "$entry"; then
			echo "Skipping '$entry' (already running)."
			skipped=$((skipped + 1))
			continue
		fi
		status=0
		start_one "$entry" || status=$?
		if ((status == 3)); then
			no_eula=$((no_eula + 1))
			continue
		fi
		((status == 0)) || return 1
		started=$((started + 1))
	done

	if ((no_eula)); then
		echo "Done. Started $started, already running $skipped, EULA not accepted $no_eula."
	else
		echo "Done. Started $started, already running $skipped."
	fi
}

stop_one() {
	local name="$1"
	require_modpack "$name" || return 1
	local session
	session="$(screen_name "$name")"

	screen -wipe >/dev/null 2>&1 || true

	if ! is_running "$name"; then
		echo "'$name' is not running."
		return 0
	fi

	if screen -S "$session" -X quit >/dev/null 2>&1; then
		echo "Stopped '$name' (screen $session)."
	else
		echo "Error: failed to stop screen $session." >&2
		return 1
	fi
}

join_screen() {
	local name="${1:-}"
	local session

	if [[ -z "$name" ]]; then
		echo "Error: missing modpack name." >&2
		return 1
	fi
	require_modpack "$name" || return 1
	if [[ ! -d "$MINECRAFT_ROOT/$name" ]]; then
		echo "Error: '$name' not found under $MINECRAFT_ROOT" >&2
		return 1
	fi
	if ! is_running "$name"; then
		echo "Error: '$name' is not running." >&2
		return 1
	fi

	session="$(screen_name "$name")"
	echo "Attaching to screen $session. Detach with Ctrl-A d to return here."
	sleep 1.5
	# Reattach if detached; if another client already has it, share the session.
	if ! screen -r "$session"; then
		screen -x "$session" || {
			echo "Error: failed to attach to screen $session." >&2
			return 1
		}
	fi
}

stop_servers() {
	local name="${1:-}"

	if [[ -n "$name" ]]; then
		require_modpack "$name" || return 1
		if [[ ! -d "$MINECRAFT_ROOT/$name" ]]; then
			echo "Error: '$name' not found under $MINECRAFT_ROOT" >&2
			return 1
		fi
		stop_one "$name"
		return
	fi

	read_index
	if ((${#INDEX_ENTRIES[@]} == 0)); then
		echo "Index is empty: $INDEX_FILE"
		return 0
	fi

	local entry
	for entry in "${INDEX_ENTRIES[@]}"; do
		stop_one "$entry" || return 1
	done
}

restart_servers() {
	local name="${1:-}"

	if [[ -n "$name" ]]; then
		require_modpack "$name" || return 1
		if [[ ! -d "$MINECRAFT_ROOT/$name" ]]; then
			echo "Error: '$name' not found under $MINECRAFT_ROOT" >&2
			return 1
		fi
		# Ask before stopping, so a declined EULA does not leave the server down.
		if [[ -d "$MINECRAFT_ROOT/$name" ]] && ! is_running "$name"; then
			ensure_eula "$name" || return
		fi
		stop_one "$name" || return 1
		sleep 1
		start_one "$name"
		return
	fi

	stop_servers || return 1
	sleep 1
	start_servers
}

run_systemctl() {
	local -a args=("$@")
	# --no-ask-password skips the polkit identity prompt. On this machine that
	# prompt asks for helen's login password, which is not the sudo password.
	if systemctl --no-ask-password "${args[@]}" 2>/dev/null; then
		return 0
	fi
	if command -v sudo >/dev/null 2>&1; then
		sudo systemctl "${args[@]}"
		return
	fi
	echo "Error: systemctl failed and sudo is unavailable." >&2
	return 1
}

service_status() {
	run_systemctl --no-pager --full status "$SYSTEMD_SERVICE" || true
}

service_start() {
	echo "Starting $SYSTEMD_SERVICE..."
	run_systemctl start "$SYSTEMD_SERVICE" || return 1
	web_service_mark active
	echo "$SYSTEMD_SERVICE start requested."
}

service_stop() {
	echo "Stopping indexed packs and $SYSTEMD_SERVICE..."
	# Unit has no ExecStop; quit screens first so servers actually halt.
	stop_servers || return 1
	run_systemctl stop "$SYSTEMD_SERVICE" || return 1
	web_service_mark inactive
	echo "$SYSTEMD_SERVICE stopped."
}

service_restart() {
	echo "Restarting indexed packs via $SYSTEMD_SERVICE..."
	stop_servers || return 1
	sleep 1
	run_systemctl restart "$SYSTEMD_SERVICE" || return 1
	web_service_mark active
	echo "$SYSTEMD_SERVICE restarted."
}

service_enable() {
	echo "Enabling $SYSTEMD_SERVICE to start at boot..."
	run_systemctl enable "$SYSTEMD_SERVICE"
	echo "$SYSTEMD_SERVICE enabled. It was not started."
}

service_disable() {
	echo "Disabling $SYSTEMD_SERVICE from starting at boot..."
	run_systemctl disable "$SYSTEMD_SERVICE"
	echo "$SYSTEMD_SERVICE disabled. Running packs were left up."
}

# systemd refuses User= that is not a real account name.
service_user() {
	local unit="${1:-$SYSTEMD_SERVICE}"
	local user="${SUDO_USER:-${USER:-}}"
	if [[ -z "$user" || "$user" == "root" ]]; then
		user="$(id -un)"
	fi
	if [[ -z "$user" || "$user" == "root" ]]; then
		echo "Error: refusing to install $unit as root. Run modman as the account that owns the modpacks." >&2
		return 1
	fi
	if ! id "$user" >/dev/null 2>&1; then
		echo "Error: user '$user' does not exist." >&2
		return 1
	fi
	printf '%s' "$user"
}

# Copy a unit or helper into place, using sudo when the destination is not writable.
install_system_file() {
	local src="$1"
	local dest="$2"
	local dest_dir
	dest_dir="$(dirname "$dest")"

	if [[ -w "$dest_dir" ]] && { [[ ! -e "$dest" ]] || [[ -w "$dest" ]]; }; then
		cp "$src" "$dest"
		return
	fi
	if command -v sudo >/dev/null 2>&1; then
		sudo cp "$src" "$dest"
		return
	fi
	echo "Error: cannot write $dest and sudo is unavailable." >&2
	return 1
}

service_install() {
	local user helper_src helper_tmp unit_tmp
	user="$(service_user)" || return 1

	if [[ ! -d "$MINECRAFT_ROOT" ]]; then
		echo "Error: modpack root not found: $MINECRAFT_ROOT" >&2
		return 1
	fi
	if ! command -v screen >/dev/null 2>&1; then
		echo "Error: screen is not installed." >&2
		return 1
	fi
	if ! command -v systemctl >/dev/null 2>&1; then
		echo "Error: systemctl is not available." >&2
		return 1
	fi

	helper_src="${TOOLS_DIR}/start_mc_servers"
	if [[ ! -f "$helper_src" ]]; then
		echo "Error: missing helper script: $helper_src" >&2
		return 1
	fi

	echo "Installing $SYSTEMD_SERVICE for user $user..."

	helper_tmp="$(mktemp "${TMPDIR:-/tmp}/start_mc_servers.XXXXXX")"
	unit_tmp="$(mktemp "${TMPDIR:-/tmp}/mc-servers.service.XXXXXX")"
	# shellcheck disable=SC2064
	trap "rm -f $(printf '%q' "$helper_tmp") $(printf '%q' "$unit_tmp")" RETURN

	sed \
		-e "s|__INDEX_FILE__|${INDEX_FILE}|g" \
		-e "s|__MINECRAFT_ROOT__|${MINECRAFT_ROOT}|g" \
		"$helper_src" >"$helper_tmp"
	chmod 755 "$helper_tmp"

	cat >"$unit_tmp" <<EOF
[Unit]
Description=Start minecraft servers in seperate screens
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=${user}
ExecStart=${SYSTEMD_HELPER}

[Install]
WantedBy=multi-user.target
EOF

	if ! install_system_file "$helper_tmp" "$SYSTEMD_HELPER"; then
		return 1
	fi
	if ! install_system_file "$unit_tmp" "$SYSTEMD_UNIT"; then
		return 1
	fi

	echo "Installed $SYSTEMD_UNIT (User=$user)."
	echo "Installed $SYSTEMD_HELPER."
	run_systemctl daemon-reload || return 1
	echo "$SYSTEMD_SERVICE installed. It was not enabled or started."
	echo "Run 'service enable' to start it at boot, or 'service start' to start it now."
}

service_control() {
	local action="${1:-}"
	case "$action" in
		status)
			service_status
			;;
		start)
			service_start
			;;
		stop)
			service_stop
			;;
		restart)
			service_restart
			;;
		enable)
			service_enable
			;;
		disable)
			service_disable
			;;
		install)
			service_install
			;;
		"")
			echo "Error: 'service' requires status, start, stop, restart, enable, disable, or install." >&2
			return 1
			;;
		*)
			echo "Error: unknown service action '$action'." >&2
			return 1
			;;
	esac
}

# CurseForge: Minecraft is game 432, modpacks are class 4471.
# Search sortField 2 is popularity.
CF_API="https://api.curseforge.com/v1"
CF_KEY_FILE="${ROOT_DIR}/data/curseforge-api-key"

read_curseforge_key() {
	local key=""
	if [[ ! -s "$CF_KEY_FILE" ]]; then
		echo "Error: put a CurseForge API key in $CF_KEY_FILE (one line)." >&2
		echo "Create one at https://console.curseforge.com" >&2
		return 1
	fi
	IFS= read -r key <"$CF_KEY_FILE" || true
	key="${key#"${key%%[![:space:]]*}"}"
	key="${key%"${key##*[![:space:]]}"}"
	if [[ -z "$key" ]]; then
		echo "Error: $CF_KEY_FILE is empty." >&2
		return 1
	fi
	printf '%s' "$key"
}

# curl config that adds the CurseForge key header. Read with curl -K -.
curl_key_config() {
	local key="$1"
	key="${key//\\/\\\\}"
	key="${key//\"/\\\"}"
	printf 'header = "x-api-key: %s"\n' "$key"
}

# Print the response body. On failure, print the HTTP status and return 1.
cf_api_get() {
	local key="$1"
	local url="$2"
	local body http
	body="$(mktemp)"
	# The key goes in through stdin so it does not show in the process list.
	if ! http="$(curl_key_config "$key" | curl -sS --retry 2 -A modman -H "Accept: application/json" -K - -o "$body" -w "%{http_code}" "$url")"; then
		rm -f "$body"
		if ((CF_CANCELLED)); then
			return 3
		fi
		echo "Error: CurseForge request failed." >&2
		return 1
	fi
	if [[ "$http" != 2* ]]; then
		echo "Error: CurseForge returned HTTP ${http}." >&2
		python3 - "$body" <<'PY' >&2 || true
import json, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
msg = data.get("errorMessage") or data.get("message")
if isinstance(msg, str) and msg:
    print(msg)
PY
		rm -f "$body"
		return 1
	fi
	cat "$body"
	rm -f "$body"
}

# Folder name matching the packs already under /srv/minecraft: the CurseForge
# name with spaces removed, and other punctuation dropped.
pack_dir_name() {
	python3 - "$1" <<'PY'
import re, sys
name = re.sub(r"\s+", "", sys.argv[1])
name = re.sub(r"[^A-Za-z0-9._-]", "", name)
if not name or name in {".", ".."} or ".." in name:
    sys.exit(1)
sys.stdout.write(name)
PY
}

# Run the python program on stdin. argv[1] is a file containing the JSON in $1.
run_python_on_json() {
	local json="$1"
	local file status=0
	file="$(mktemp)"
	printf '%s\n' "$json" >"$file"
	python3 - "$file" || status=$?
	rm -f "$file"
	return "$status"
}

# TSV: id, name, download count, summary. Empty output means no matches.
cf_search_modpacks() {
	local key="$1"
	local query="$2"
	local encoded body
	encoded="$(python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))' "$query")"
	body="$(cf_api_get "$key" "${CF_API}/mods/search?gameId=432&classId=4471&pageSize=10&sortField=2&sortOrder=desc&searchFilter=${encoded}")" || return 1
	run_python_on_json "$body" <<'PY'
import json, sys
mods = (json.load(open(sys.argv[1])).get("data") or [])
for mod in mods:
    name = (mod.get("name") or "").replace("\t", " ").replace("\n", " ").strip()
    summary = (mod.get("summary") or "").replace("\t", " ").replace("\n", " ").strip()
    if len(summary) > 110:
        summary = summary[:107] + "..."
    downloads = f"{int(mod.get('downloadCount') or 0):,}"
    print(f"{mod.get('id')}\t{name}\t{downloads}\t{summary}")
PY
}

# Newest release that has a server pack. Prints the server-pack file id.
# Returns 2 when the project has no server pack.
cf_server_pack_file() {
	local key="$1"
	local mod_id="$2"
	local body status=0
	body="$(cf_api_get "$key" "${CF_API}/mods/${mod_id}/files?pageSize=50")" || return 1
	run_python_on_json "$body" <<'PY' || status=$?
import json, sys
files = json.load(open(sys.argv[1])).get("data") or []
files.sort(key=lambda f: f.get("fileDate") or "", reverse=True)

def first(pred):
    for f in files:
        if pred(f):
            return f
    return None

def release(f):
    return f.get("releaseType") == 1

chosen = None
hit = first(lambda f: release(f) and f.get("serverPackFileId"))
if hit:
    chosen = hit["serverPackFileId"]
if chosen is None:
    hit = first(lambda f: release(f) and f.get("isServerPack"))
    if hit:
        chosen = hit["id"]
if chosen is None:
    hit = first(lambda f: f.get("serverPackFileId"))
    if hit:
        chosen = hit["serverPackFileId"]
if chosen is None:
    hit = first(lambda f: f.get("isServerPack"))
    if hit:
        chosen = hit["id"]
if chosen is None:
    sys.exit(2)
print(chosen)
PY
	if ((status == 2)); then
		echo "Error: that modpack has no server pack on CurseForge." >&2
		return 1
	fi
	if ((status != 0)); then
		echo "Error: could not read the CurseForge file list." >&2
		return 1
	fi
}

# TSV: display name, file name, Minecraft versions.
cf_file_meta() {
	local key="$1"
	local mod_id="$2"
	local file_id="$3"
	local body
	body="$(cf_api_get "$key" "${CF_API}/mods/${mod_id}/files/${file_id}")" || return 1
	run_python_on_json "$body" <<'PY'
import json, sys
data = json.load(open(sys.argv[1])).get("data") or {}
display = (data.get("displayName") or data.get("fileName") or "server pack").replace("\t", " ").replace("\n", " ")
filename = (data.get("fileName") or "server-pack.zip").replace("\t", " ").replace("\n", " ")
versions = []
for version in data.get("gameVersions") or []:
    if "." in version and any(ch.isdigit() for ch in version):
        versions.append(version)
print(f"{display}\t{filename}\t{', '.join(versions)}")
PY
}

# Print the CurseForge project name for a numeric project id.
cf_mod_name() {
	local key="$1"
	local mod_id="$2"
	local body
	body="$(cf_api_get "$key" "${CF_API}/mods/${mod_id}")" || return 1
	run_python_on_json "$body" <<'PY'
import json, sys
data = json.load(open(sys.argv[1])).get("data") or {}
name = (data.get("name") or "").replace("\n", " ").strip()
if not name:
    sys.exit(1)
print(name)
PY
}

cf_download_url() {
	local key="$1"
	local mod_id="$2"
	local file_id="$3"
	local body
	body="$(cf_api_get "$key" "${CF_API}/mods/${mod_id}/files/${file_id}/download-url")" || return 1
	run_python_on_json "$body" <<'PY'
import json, sys
data = json.load(open(sys.argv[1])).get("data")
if isinstance(data, dict):
    data = data.get("url") or data.get("downloadUrl")
if not isinstance(data, str) or not data:
    sys.exit(1)
print(data)
PY
}

# Unpack a server-pack zip and print the pack directory.
cf_extract_root() {
	local zip="$1"
	local dest="$2"
	python3 - "$zip" "$dest" <<'PY'
import os, sys, zipfile
zip_path, dest = sys.argv[1], sys.argv[2]
with zipfile.ZipFile(zip_path) as zf:
    for info in zf.infolist():
        name = info.filename.replace("\\", "/")
        parts = [p for p in name.split("/") if p not in ("", ".")]
        if name.startswith("/") or any(p == ".." for p in parts):
            sys.stderr.write(f"Error: archive path escapes the pack: {info.filename}\n")
            sys.exit(1)
    zf.extractall(dest)

HINTS = {"start.sh", "run.sh", "startserver.sh", "start_server.sh", "serverstart.sh", "server.jar", "user_jvm_args.txt"}

def hinted(filenames):
    if HINTS.intersection(filenames):
        return True
    for name in filenames:
        lower = name.lower()
        if lower.endswith(".jar") and "installer" not in lower and "server" in lower:
            return True
        if lower.endswith(".jar") and "installer" in lower and ("forge" in lower or "neoforge" in lower):
            return True
    return False

found = []
for dirpath, dirnames, filenames in os.walk(dest):
    dirnames[:] = [d for d in dirnames if d != "__MACOSX"]
    rel = os.path.relpath(dirpath, dest)
    depth = 0 if rel == "." else rel.count(os.sep) + 1
    if depth > 2:
        dirnames[:] = []
        continue
    if hinted(filenames):
        found.append((depth, dirpath, "start.sh" in filenames))
if found:
    found.sort(key=lambda item: (0 if item[2] else 1, item[0]))
    kind = found[0][2]
    depth = found[0][0]
    best = [path for item_depth, path, has_start in found if item_depth == depth and has_start == kind]
    if len(best) != 1:
        sys.stderr.write("Error: server pack has more than one launch directory\n")
        sys.exit(1)
    print(best[0])
    sys.exit(0)

print(dest)
PY
}

# Write start.sh when the pack did not ship one. Prints "generated" on success.
# Returns 2 when the pack has nothing to launch. The optional java binary is used
# in a generated script.
cf_write_start_sh() {
	local root="$1"
	local java="${2:-java}"
	python3 - "$root" "$java" <<'PY'
import os, stat, sys
root = sys.argv[1]
dest = os.path.join(root, "start.sh")
if os.path.exists(dest):
    sys.exit(0)

def sh_quote(text):
    return "'" + text.replace("'", "'\\''") + "'"

def write(body, also_exec=None):
    with open(dest, "w", newline="\n") as fh:
        fh.write(body)
    os.chmod(dest, os.stat(dest).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    if also_exec:
        path = os.path.join(root, also_exec)
        if os.path.isfile(path):
            os.chmod(path, os.stat(path).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    print("generated")

header = "#!/bin/sh\ncd \"$(dirname \"$0\")\"\n"
java = sys.argv[2] if len(sys.argv) > 2 and sys.argv[2] else "java"
if java != "java":
    java = sh_quote(java)
files_here = {
    name.lower(): name
    for name in os.listdir(root)
    if os.path.isfile(os.path.join(root, name))
}
for name in ("run.sh", "startserver.sh", "start_server.sh", "serverstart.sh"):
    actual = files_here.get(name)
    if actual:
        src = os.path.join(root, actual)
        os.rename(src, dest)
        with open(dest, "rb") as fh:
            body = fh.read()
        # The old wrapper passed nogui. Keep that when the script forwards its arguments.
        code = b"\n".join(
            line for line in body.splitlines()
            if not line.lstrip().startswith(b"#")
        )
        if b"nogui" not in code and b'"$@"' in code:
            body = body.replace(b'"$@"', b'nogui "$@"', 1)
            with open(dest, "wb") as fh:
                fh.write(body)
        os.chmod(dest, os.stat(dest).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
        print(f"renamed {actual}")
        sys.exit(0)

unix = []
for dirpath, dirnames, filenames in os.walk(root):
    dirnames[:] = [d for d in dirnames if d != "__MACOSX"]
    if "unix_args.txt" in filenames:
        unix.append(os.path.relpath(os.path.join(dirpath, "unix_args.txt"), root))
if len(unix) > 1:
    sys.stderr.write("Error: server pack has more than one unix_args.txt\n")
    sys.exit(1)
if len(unix) == 1:
    args = sh_quote(unix[0])
    if os.path.isfile(os.path.join(root, "user_jvm_args.txt")):
        write(header + f"exec {java} @user_jvm_args.txt @{args} nogui\n")
    else:
        write(header + f"exec {java} -Xms4G -Xmx8G @{args} nogui\n")
    sys.exit(0)

jars = []
for name in os.listdir(root):
    if name.lower().endswith(".jar") and os.path.isfile(os.path.join(root, name)):
        if "installer" not in name.lower():
            jars.append(name)

def rank(name):
    lower = name.lower()
    if lower == "server.jar":
        return 0
    if "server" in lower:
        return 1
    return 5

if jars:
    jars.sort(key=lambda name: (rank(name), name))
    best = rank(jars[0])
    tied = [name for name in jars if rank(name) == best]
    lone = jars[0].lower()
    lone_ok = any(token in lone for token in ("forge", "fabric", "neoforge", "minecraft", "server", "quilt"))
    if best < 5 or (len(jars) == 1 and lone_ok):
        if len(tied) == 1:
            jar = sh_quote(tied[0])
            if os.path.isfile(os.path.join(root, "user_jvm_args.txt")):
                write(header + f"exec {java} @user_jvm_args.txt -jar {jar} nogui\n")
            else:
                write(header + f"exec {java} -Xms4G -Xmx8G -jar {jar} nogui\n")
            sys.exit(0)

installers = [
    name for name in files_here.values()
    if name.lower().endswith(".jar")
    and "installer" in name.lower()
    and ("forge" in name.lower() or "neoforge" in name.lower())
]
if len(installers) == 1:
    jar = sh_quote(installers[0])
    # Forge 1.17 and newer writes run.sh. Older Forge writes forge-<version>.jar.
    write(
        header
        + "if [ ! -f ./run.sh ] && [ ! -f ./.modman-installed ]; then\n"
        + f"  {java} -jar {jar} --installServer || exit 1\n"
        + "  touch ./.modman-installed\n"
        + "fi\n"
        + "if [ -f ./run.sh ]; then\n"
        + "  exec sh ./run.sh nogui\n"
        + "fi\n"
        + "for jar in forge-*.jar; do\n"
        + "  case \"$jar\" in\n"
        + "  *installer*) ;;\n"
        + f"  *) exec {java} -Xms4G -Xmx8G -jar \"$jar\" nogui ;;\n"
        + "  esac\n"
        + "done\n"
        + "echo \"Forge server jar not found after install.\" >&2\n"
        + "exit 1\n"
    )
    sys.exit(0)

sys.exit(2)
PY
}

# Loader the client pack's manifest asks for, for a server-pack file id.
# Prints "loader<TAB>loader-version<TAB>minecraft-version", e.g. "forge	14.23.5.2860	1.12.2".
cf_client_loader() {
	local key="$1"
	local mod_id="$2"
	local file_id="$3"
	local work="$4"
	local body parent url zip
	body="$(cf_api_get "$key" "${CF_API}/mods/${mod_id}/files/${file_id}")" || return 1
	parent="$(run_python_on_json "$body" <<'PY'
import json, sys
data = json.load(open(sys.argv[1])).get("data") or {}
parent = data.get("parentProjectFileId")
if isinstance(parent, int) and parent > 0:
    print(parent)
PY
)" || return 1
	if [[ -z "$parent" ]]; then
		body="$(cf_api_get "$key" "${CF_API}/mods/${mod_id}/files?pageSize=50")" || return 1
		parent="$(FILE_ID="$file_id" run_python_on_json "$body" <<'PY'
import json, os, sys
want = int(os.environ["FILE_ID"])
for f in json.load(open(sys.argv[1])).get("data") or []:
    if f.get("serverPackFileId") == want:
        print(f["id"])
        break
PY
)" || return 1
	fi
	if [[ ! "$parent" =~ ^[0-9]+$ ]]; then
		echo "Error: could not find the client pack for this server pack." >&2
		return 1
	fi
	url="$(cf_download_url "$key" "$mod_id" "$parent")" || return 1
	zip="${work}/client.zip"
	echo "Reading the mod loader version from the client pack..." >&2
	if ! curl -fL --proto =https --retry 2 -A modman -o "$zip" -# "$url"; then
		echo "Error: client pack download failed." >&2
		return 1
	fi
	python3 - "$zip" <<'PY'
import json, re, sys, zipfile
try:
    with zipfile.ZipFile(sys.argv[1]) as zf:
        manifest = json.load(zf.open("manifest.json"))
except Exception:
    sys.stderr.write("Error: client pack has no readable manifest.json\n")
    sys.exit(1)
mc = (manifest.get("minecraft") or {})
version = mc.get("version") or ""
loaders = mc.get("modLoaders") or []
loaders.sort(key=lambda item: 0 if item.get("primary") else 1)
loader = loaders[0].get("id", "") if loaders else ""
match = re.fullmatch(r"(forge|neoforge|fabric|quilt)-([0-9A-Za-z.+_-]+)", loader)
if not match or not re.fullmatch(r"[0-9][0-9A-Za-z.+_-]*", version):
    sys.stderr.write(f"Error: client pack names an unknown mod loader '{loader}'\n")
    sys.exit(1)
print(f"{match.group(1)}\t{match.group(2)}\t{version}")
PY
}

# Download a mod loader into a server pack that shipped without one.
cf_fetch_loader() {
	local root="$1"
	local loader="$2"
	local version="$3"
	local mc="$4"
	local url out installer
	case "$loader" in
	forge)
		url="https://maven.minecraftforge.net/net/minecraftforge/forge/${mc}-${version}/forge-${mc}-${version}-installer.jar"
		out="forge-${mc}-${version}-installer.jar"
		;;
	neoforge)
		url="https://maven.neoforged.net/releases/net/neoforged/neoforge/${version}/neoforge-${version}-installer.jar"
		out="neoforge-${version}-installer.jar"
		;;
	fabric)
		installer="$(curl -fsS --proto =https --retry 2 -A modman "https://meta.fabricmc.net/v2/versions/installer" | python3 -c '
import json, sys
for item in json.load(sys.stdin):
    if item.get("stable"):
        print(item["version"])
        break
')" || installer=""
		if [[ ! "$installer" =~ ^[0-9][0-9A-Za-z.+_-]*$ ]]; then
			echo "Error: could not look up the Fabric installer version." >&2
			return 1
		fi
		url="https://meta.fabricmc.net/v2/versions/loader/${mc}/${version}/${installer}/server/jar"
		out="fabric-server-launch.jar"
		;;
	*)
		echo "Error: the server pack ships no launcher, and modman cannot install ${loader} ${version}." >&2
		return 1
		;;
	esac
	echo "The server pack ships no launcher. Downloading ${loader} ${version} for Minecraft ${mc}..." >&2
	if ! curl -fL --proto =https --retry 2 -A modman -o "${root}/${out}" -# "$url"; then
		rm -f "${root}/${out}"
		echo "Error: ${loader} download failed." >&2
		return 1
	fi
}

# Java 8 binary for Minecraft before 1.17, which Forge and Fabric of that era need.
# Prints nothing to use the default java.
cf_java_for_mc() {
	local mc="$1"
	local minor bin
	minor="${mc#1.}"
	minor="${minor%%.*}"
	if [[ ! "$minor" =~ ^[0-9]+$ ]] || ((minor >= 17)); then
		return 0
	fi
	for bin in /usr/lib/jvm/*-8-*/bin/java /usr/lib/jvm/*-1.8.0*/bin/java /usr/lib/jvm/*-1.8.0*/jre/bin/java /usr/lib/jvm/*jdk8*/bin/java; do
		if [[ -x "$bin" ]]; then
			printf '%s' "$bin"
			return 0
		fi
	done
	echo "Warning: Minecraft ${mc} needs Java 8, and none was found in /usr/lib/jvm. The server will not start until Java 8 is installed and start.sh points at it." >&2
}

# Ask for a search string. Prints the trimmed query on stdout.
# Returns 3 when the user cancels.
cf_prompt_modpack_query() {
	local query
	echo "What modpack would you like to search for?" >&2
	CF_CANCELLED=0
	trap 'CF_CANCELLED=1' INT
	if ! read -r -e -p "Modpack, or press Enter to cancel: " query; then
		trap - INT
		echo
		echo "Cancelled." >&2
		return 3
	fi
	trap - INT
	if ((CF_CANCELLED)); then
		echo
		echo "Cancelled." >&2
		return 3
	fi
	query="${query#"${query%%[![:space:]]*}"}"
	query="${query%"${query##*[![:space:]]}"}"
	if [[ -z "$query" ]]; then
		echo "Cancelled." >&2
		return 3
	fi
	printf '%s\n' "$query"
}

# Search and let the user pick. Prints "id<TAB>name" on success.
# Returns 2 when nothing matches, 3 when the user cancels.
cf_select_modpack() {
	local key="$1"
	local query="$2"
	local tsv id name downloads summary
	local -a ids=() names=()
	local n=0 choice idx

	echo "Searching CurseForge..." >&2
	CF_CANCELLED=0
	trap 'CF_CANCELLED=1' INT
	tsv="$(cf_search_modpacks "$key" "$query")" || n=$?
	trap - INT
	if ((CF_CANCELLED)); then
		echo
		echo "Cancelled." >&2
		return 3
	fi
	if ((n != 0)); then
		return "$n"
	fi
	while IFS=$'\t' read -r id name downloads summary; do
		[[ -n "$id" ]] || continue
		n=$((n + 1))
		ids+=("$id")
		names+=("$name")
		printf '  %2d  %s  (id %s)\n' "$n" "$name" "$id" >&2
		if [[ -n "$summary" ]]; then
			printf '      %s downloads. %s\n' "$downloads" "$summary" >&2
		else
			printf '      %s downloads.\n' "$downloads" >&2
		fi
	done <<<"$tsv"
	if ((n == 0)); then
		echo "No modpacks matched '$query'." >&2
		return 2
	fi

	CF_CANCELLED=0
	trap 'CF_CANCELLED=1' INT
	if ! read -r -e -p "Select a modpack by number, or press Enter to cancel: " choice; then
		trap - INT
		echo
		echo "Cancelled." >&2
		return 3
	fi
	trap - INT
	if ((CF_CANCELLED)); then
		echo
		echo "Cancelled." >&2
		return 3
	fi
	if [[ -z "$choice" ]]; then
		echo "Cancelled." >&2
		return 3
	fi
	if [[ ! "$choice" =~ ^[0-9]+$ ]]; then
		echo "Error: '$choice' is not a number in the list." >&2
		return 1
	fi
	choice=$((10#$choice))
	if ((choice < 1 || choice > n)); then
		echo "Error: '$choice' is not a number in the list." >&2
		return 1
	fi

	idx=$((choice - 1))
	printf '%s\t%s\n' "${ids[$idx]}" "${names[$idx]}"
}

# Read .curseforge-id. Prints "project_id<TAB>file_id" (file_id may be empty).
# Returns 2 when the project id is missing.
read_curseforge_id() {
	local file="$1"
	local line id="" file_id=""
	[[ -f "$file" ]] || return 2
	while IFS= read -r line || [[ -n "$line" ]]; do
		case "$line" in
			id=*) id="${line#id=}" ;;
			file=*) file_id="${line#file=}" ;;
		esac
	done <"$file"
	id="${id//[[:space:]]/}"
	file_id="${file_id//[[:space:]]/}"
	[[ "$id" =~ ^[0-9]+$ ]] || return 2
	if [[ -n "$file_id" && ! "$file_id" =~ ^[0-9]+$ ]]; then
		file_id=""
	fi
	printf '%s\t%s\n' "$id" "$file_id"
}

# Download and unpack a server pack. Prints workdir, pack root, and whether
# start.sh was generated ("generated" or "-").
cf_stage_server_pack() {
	local key="$1"
	local mod_id="$2"
	local file_id="$3"
	local url work zip root generated="-" status=0
	local loader loader_name loader_version mc_version java

	url="$(cf_download_url "$key" "$mod_id" "$file_id")" || return 1
	work="$(mktemp -d)"
	zip="${work}/pack.zip"
	# The download host is CurseForge's file CDN, which does not need the key.
	if ! curl -fL --proto =https --retry 2 -A modman -o "$zip" -# "$url"; then
		rm -rf "$work"
		echo "Error: download failed." >&2
		return 1
	fi
	if ! root="$(cf_extract_root "$zip" "${work}/pack")"; then
		rm -rf "$work"
		return 1
	fi
	if [[ ! -f "$root/start.sh" ]]; then
		generated="$(cf_write_start_sh "$root")" || status=$?
		if ((status == 2)); then
			# Some packs (RLCraft, for one) ship only mods and configs. Get the
			# loader the client pack names.
			status=0
			if ! loader="$(cf_client_loader "$key" "$mod_id" "$file_id" "$work")" ||
				! IFS=$'\t' read -r loader_name loader_version mc_version <<<"$loader" ||
				! cf_fetch_loader "$root" "$loader_name" "$loader_version" "$mc_version"; then
				rm -rf "$work"
				echo "Error: server pack has no start.sh, run script, or server jar" >&2
				return 1
			fi
			java="$(cf_java_for_mc "$mc_version")"
			generated="$(cf_write_start_sh "$root" "$java")" || status=$?
		fi
		if ((status != 0)); then
			rm -rf "$work"
			if ((status == 2)); then
				echo "Error: server pack has no start.sh, run script, or server jar" >&2
			fi
			return 1
		fi
	fi
	printf '%s\n%s\n%s\n' "$work" "$root" "$generated"
}

# Ask whether to keep the world. Returns 0 to keep it, 2 when delete was confirmed.
cf_prompt_world_choice() {
	local dest="$1"
	local choice answer

	if [[ -n "${MODMAN_WORLD:-}" ]]; then
		case "$MODMAN_WORLD" in
		keep)
			return 0
			;;
		delete)
			return 2
			;;
		*)
			echo "Error: world must be keep or delete." >&2
			return 1
			;;
		esac
	fi
	echo "Keep the world, or delete it?"
	if ! read -r -e -p "World [keep/delete]: " choice; then
		echo
		return 1
	fi
	case "${choice,,}" in
	keep)
		return 0
		;;
	delete)
		;;
	*)
		echo "Cancelled."
		return 3
		;;
	esac
	echo "Delete world, world_nether, and world_the_end in ${dest}?"
	if ! read -r -e -p "Type yes to delete the world: " answer; then
		echo
		return 1
	fi
	if [[ "${answer,,}" != "yes" ]]; then
		echo "Cancelled."
		return 3
	fi
	return 2
}

# Replace dest with the staged pack. Keep local server files.
# The third argument is 1 to keep the world, or 0 to leave it behind.
cf_replace_pack() {
	local name="$1"
	local root="$2"
	local keep_world="${3:-1}"
	local dest="${MINECRAFT_ROOT}/${name}"
	local backup="${MINECRAFT_ROOT}/.modman-update-${name}"
	local hold item
	local -a keep=(
		server.properties ops.json whitelist.json
		banned-players.json banned-ips.json eula.txt
	)
	if [[ "$keep_world" == "1" ]]; then
		keep=(world world_nether world_the_end "${keep[@]}")
	fi

	if [[ -e "$backup" ]]; then
		echo "Error: '$backup' already exists. Move it aside before updating." >&2
		return 1
	fi
	hold="$(mktemp -d)"
	for item in "${keep[@]}"; do
		if [[ -e "$dest/$item" || -L "$dest/$item" ]]; then
			mv "$dest/$item" "$hold/$item"
		fi
	done
	if ! mv "$dest" "$backup"; then
		mkdir -p "$dest"
		for item in "${keep[@]}"; do
			if [[ -e "$hold/$item" || -L "$hold/$item" ]]; then
				mv "$hold/$item" "$dest/$item"
			fi
		done
		rm -rf "$hold"
		echo "Error: failed to move $dest aside." >&2
		return 1
	fi
	if ! mkdir "$dest"; then
		mv "$backup" "$dest"
		for item in "${keep[@]}"; do
			if [[ -e "$hold/$item" || -L "$hold/$item" ]]; then
				rm -rf "$dest/$item"
				mv "$hold/$item" "$dest/$item"
			fi
		done
		rm -rf "$hold"
		echo "Error: failed to create $dest" >&2
		return 1
	fi
	if ! cp -a "${root}/." "$dest/"; then
		rm -rf "$dest"
		mv "$backup" "$dest"
		for item in "${keep[@]}"; do
			if [[ -e "$hold/$item" || -L "$hold/$item" ]]; then
				rm -rf "$dest/$item"
				mv "$hold/$item" "$dest/$item"
			fi
		done
		rm -rf "$hold"
		echo "Error: failed to copy the server pack into $dest" >&2
		return 1
	fi
	for item in "${keep[@]}"; do
		if [[ -e "$hold/$item" || -L "$hold/$item" ]]; then
			rm -rf "$dest/$item"
			mv "$hold/$item" "$dest/$item"
		fi
	done
	rm -rf "$hold" "$backup"
}

install_modpack() {
	local key query picked select_status=0
	local mod_id mod_name

	if ! command -v curl >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
		echo "Error: install needs curl and python3." >&2
		return 1
	fi
	if [[ ! -d "$MINECRAFT_ROOT" ]]; then
		echo "Error: $MINECRAFT_ROOT does not exist." >&2
		return 1
	fi
	key="$(read_curseforge_key)" || return 1
	query="$(cf_prompt_modpack_query)" || select_status=$?
	if ((select_status == 3)); then
		return 0
	fi
	if ((select_status != 0)); then
		return 1
	fi
	picked="$(cf_select_modpack "$key" "$query")" || select_status=$?
	if ((select_status == 2 || select_status == 3)); then
		return 0
	fi
	if ((select_status != 0)); then
		return 1
	fi
	IFS=$'\t' read -r mod_id mod_name <<<"$picked"
	install_chosen_modpack "$mod_id" "$mod_name"
}

# Download and unpack a CurseForge project that has already been chosen.
install_chosen_modpack() {
	local mod_id="$1"
	local mod_name="$2"
	local key folder dest
	local file_id meta display versions
	local staged work root generated status=0

	if [[ ! "$mod_id" =~ ^[0-9]+$ ]]; then
		echo "Error: bad CurseForge project id." >&2
		return 1
	fi
	if ! command -v curl >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
		echo "Error: install needs curl and python3." >&2
		return 1
	fi
	if [[ ! -d "$MINECRAFT_ROOT" ]]; then
		echo "Error: $MINECRAFT_ROOT does not exist." >&2
		return 1
	fi
	key="$(read_curseforge_key)" || return 1
	if ! folder="$(pack_dir_name "$mod_name")"; then
		echo "Error: cannot make a folder name from '$mod_name'." >&2
		return 1
	fi
	dest="${MINECRAFT_ROOT}/${folder}"
	if [[ -e "$dest" ]]; then
		echo "Error: '$dest' already exists." >&2
		return 1
	fi

	echo "Looking up the server pack for ${mod_name}..."
	file_id="$(cf_server_pack_file "$key" "$mod_id")" || return 1
	meta="$(cf_file_meta "$key" "$mod_id" "$file_id")" || return 1
	IFS=$'\t' read -r display _ versions <<<"$meta"

	if [[ -n "$versions" ]]; then
		echo "Installing ${display} (Minecraft ${versions}) into ${dest}"
	else
		echo "Installing ${display} into ${dest}"
	fi

	staged="$(cf_stage_server_pack "$key" "$mod_id" "$file_id")" || return 1
	{
		IFS= read -r work
		IFS= read -r root
		IFS= read -r generated
	} <<<"$staged"
	if ! mkdir "$dest"; then
		rm -rf "$work"
		echo "Error: failed to create $dest" >&2
		return 1
	fi
	if ! cp -a "${root}/." "$dest/"; then
		rm -rf "$dest" "$work"
		echo "Error: failed to copy the server pack into $dest" >&2
		return 1
	fi
	rm -rf "$work"
	chmod +x "$dest/start.sh" || status=$?
	if ((status != 0)); then
		rm -rf "$dest"
		echo "Error: failed to make start.sh executable." >&2
		return 1
	fi
	if ! printf 'id=%s\nfile=%s\n' "$mod_id" "$file_id" >"$dest/.curseforge-id"; then
		rm -rf "$dest"
		echo "Error: failed to write $dest/.curseforge-id" >&2
		return 1
	fi

	echo "Installed ${mod_name} in ${dest}"
	if [[ "$generated" == "generated" ]]; then
		echo "Wrote start.sh; the server pack did not include one."
	elif [[ "$generated" == renamed\ * ]]; then
		echo "Renamed ${generated#renamed } to start.sh."
	fi
	echo "CurseForge project id ${mod_id} saved in ${dest}/.curseforge-id"
	echo "Enable it with: enable ${folder}"
}

update_modpack() {
	local name="${1:-}"
	local dest id_file key picked select_status=0
	local mod_id="" mod_name="" known_file=""
	local file_id meta display versions answer
	local staged work root generated status=0
	local was_running=0 keep_world=1 world_status=0

	if [[ -z "$name" ]]; then
		echo "Error: missing modpack name." >&2
		return 1
	fi
	require_modpack "$name" || return 1
	if ! command -v curl >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
		echo "Error: update needs curl and python3." >&2
		return 1
	fi
	dest="${MINECRAFT_ROOT}/${name}"
	if [[ -L "$dest" ]]; then
		echo "Error: '$dest' is a symlink." >&2
		return 1
	fi
	if [[ ! -d "$dest" ]]; then
		echo "Error: '$name' not found under $MINECRAFT_ROOT" >&2
		return 1
	fi
	key="$(read_curseforge_key)" || return 1

	id_file="${dest}/.curseforge-id"
	if picked="$(read_curseforge_id "$id_file")"; then
		IFS=$'\t' read -r mod_id known_file <<<"$picked"
		mod_name="$name"
	elif [[ -n "${MODMAN_MOD_ID:-}" ]]; then
		mod_id="$MODMAN_MOD_ID"
		mod_name="$name"
	elif [[ "${MODMAN_YES:-}" == "1" ]]; then
		echo "Error: no CurseForge id in ${id_file}. Choose the modpack in the webpage search." >&2
		return 1
	else
		echo "No CurseForge id in ${id_file}."
		echo "Searching CurseForge for '${name}'..."
		picked="$(cf_select_modpack "$key" "$name")" || select_status=$?
		if ((select_status == 2)); then
			echo "Search by the name used on CurseForge."
			select_status=0
			picked="$(cf_prompt_modpack_query)" || select_status=$?
			if ((select_status == 3)); then
				return 0
			fi
			if ((select_status != 0)); then
				return 1
			fi
			picked="$(cf_select_modpack "$key" "$picked")" || select_status=$?
		fi
		if ((select_status == 2 || select_status == 3)); then
			return 0
		fi
		if ((select_status != 0)); then
			return 1
		fi
		IFS=$'\t' read -r mod_id mod_name <<<"$picked"
	fi

	echo "Looking up the server pack for ${mod_name}..."
	file_id="$(cf_server_pack_file "$key" "$mod_id")" || return 1
	if [[ -n "$known_file" && "$known_file" == "$file_id" ]]; then
		echo "'${name}' is already on the latest version."
		return 0
	fi
	meta="$(cf_file_meta "$key" "$mod_id" "$file_id")" || return 1
	IFS=$'\t' read -r display _ versions <<<"$meta"

	if [[ -n "$versions" ]]; then
		echo "Update ${name} to ${display} (Minecraft ${versions})?"
	else
		echo "Update ${name} to ${display}?"
	fi
	cf_prompt_world_choice "$dest" || world_status=$?
	if ((world_status == 3)); then
		return 0
	fi
	if ((world_status != 0 && world_status != 2)); then
		return 1
	fi
	if ((world_status == 2)); then
		keep_world=0
	fi
	if ((keep_world)); then
		echo "The world, server.properties, ops, whitelist, bans, and eula.txt are kept."
	else
		echo "The world will be deleted. server.properties, ops, whitelist, bans, and eula.txt are kept."
	fi
	if is_running "$name"; then
		was_running=1
		echo "The server is running and will be stopped first."
	fi
	if [[ "${MODMAN_YES:-}" == "1" ]]; then
		answer=yes
	elif ! read -r -e -p "Type yes to confirm: " answer; then
		echo
		return 1
	fi
	if [[ "${answer,,}" != "yes" ]]; then
		echo "Cancelled."
		return 0
	fi

	if ((was_running)); then
		stop_one "$name" || return 1
	fi

	staged="$(cf_stage_server_pack "$key" "$mod_id" "$file_id")" || return 1
	{
		IFS= read -r work
		IFS= read -r root
		IFS= read -r generated
	} <<<"$staged"
	if ! cf_replace_pack "$name" "$root" "$keep_world"; then
		rm -rf "$work"
		return 1
	fi
	rm -rf "$work"
	if ! printf 'id=%s\nfile=%s\n' "$mod_id" "$file_id" >"$dest/.curseforge-id"; then
		echo "Error: failed to write $dest/.curseforge-id" >&2
		return 1
	fi
	chmod +x "$dest/start.sh" || status=$?
	if ((status != 0)); then
		echo "Error: failed to make start.sh executable." >&2
		return 1
	fi

	echo "Updated '${name}' in ${dest}"
	if [[ "$generated" == "generated" ]]; then
		echo "Wrote start.sh; the server pack did not include one."
	elif [[ "$generated" == renamed\ * ]]; then
		echo "Renamed ${generated#renamed } to start.sh."
	fi
	echo "CurseForge project id ${mod_id} saved in ${dest}/.curseforge-id"
	if ((was_running)); then
		echo "Start it with: start ${name}"
	fi
}

require_arg() {
	local cmd="$1"
	local value="${2:-}"
	if [[ -z "$value" ]]; then
		echo "Error: '$cmd' requires a modpack name." >&2
		return 1
	fi
}

require_two_args() {
	local cmd="$1"
	local first="${2:-}"
	local second="${3:-}"
	if [[ -z "$first" || -z "$second" ]]; then
		echo "Error: '$cmd' requires two arguments." >&2
		return 1
	fi
}

# Returns 2 for exit so the REPL can leave; 0 on success; 1 on error.
# Remember an explicit start or stop. The unit exits after launching screens,
# so systemd reports it inactive even when that start succeeded.
web_service_mark() {
	local word="$1"
	printf '%s\n' "$word" >"$WEB_SERVICE_STATE_FILE"
}

# active when systemd says so, or when the last successful start has not been
# followed by a stop.
web_service_activity() {
	local live result status saved
	local inactive_exit active_exit file_epoch exit_epoch
	live="$(systemctl is-active "$SYSTEMD_SERVICE" 2>/dev/null || true)"
	case "$live" in
	active|activating|reloading)
		printf '%s' "active"
		return
		;;
	failed)
		printf '%s' "failed"
		return
		;;
	esac
	if [[ -f "$WEB_SERVICE_STATE_FILE" ]]; then
		inactive_exit="$(systemctl show -p InactiveExitTimestamp --value "$SYSTEMD_SERVICE" 2>/dev/null || true)"
		file_epoch="$(stat -c %Y "$WEB_SERVICE_STATE_FILE" 2>/dev/null || echo 0)"
		exit_epoch=0
		if [[ -n "$inactive_exit" && "$inactive_exit" != "n/a" ]]; then
			exit_epoch="$(date -d "$inactive_exit" +%s 2>/dev/null || echo 0)"
		fi
		if ((file_epoch >= exit_epoch)); then
			IFS= read -r saved <"$WEB_SERVICE_STATE_FILE" || true
			case "$saved" in
			active|inactive|failed)
				printf '%s' "$saved"
				return
				;;
			esac
		fi
	fi
	result="$(systemctl show -p Result --value "$SYSTEMD_SERVICE" 2>/dev/null || true)"
	status="$(systemctl show -p ExecMainStatus --value "$SYSTEMD_SERVICE" 2>/dev/null || true)"
	active_exit="$(systemctl show -p ActiveExitTimestampMonotonic --value "$SYSTEMD_SERVICE" 2>/dev/null || echo 0)"
	inactive_exit="$(systemctl show -p InactiveExitTimestampMonotonic --value "$SYSTEMD_SERVICE" 2>/dev/null || echo 0)"
	[[ "$active_exit" =~ ^[0-9]+$ ]] || active_exit=0
	[[ "$inactive_exit" =~ ^[0-9]+$ ]] || inactive_exit=0
	if [[ "$result" == "success" && "$status" == "0" && "$inactive_exit" -gt 0 && "$inactive_exit" -ge "$active_exit" ]]; then
		printf '%s' "active"
		return
	fi
	if [[ -n "$live" ]]; then
		printf '%s' "$live"
	else
		printf '%s' "unknown"
	fi
}

# Java major version each pack needs, from its Minecraft version.
# Prints "name<TAB>major" per pack, with "-" when the version is unknown.
packs_required_java() {
	python3 - "$MINECRAFT_ROOT" "$@" <<'PY'
import json, os, re, sys, zipfile
root = sys.argv[1]
MC = re.compile(r"(?<![0-9])(1\.[0-9]{1,2}(?:\.[0-9]{1,2})?)(?![0-9])")

def java_for(version):
    parts = [int(p) for p in version.split(".")]
    if parts[0] >= 2:
        # Year-based versions (26.1 and later) need Java 25.
        return 25
    minor = parts[1] if len(parts) > 1 else 0
    patch = parts[2] if len(parts) > 2 else 0
    if minor < 17:
        return 8
    if minor == 17:
        return 16
    if minor < 20 or (minor == 20 and patch < 5):
        return 17
    return 21

def from_server_jar(path):
    try:
        with zipfile.ZipFile(path) as zf:
            data = json.load(zf.open("version.json"))
    except Exception:
        return None
    need = data.get("java_version")
    return need if isinstance(need, int) else None

def required(pack):
    jar = os.path.join(pack, "server.jar")
    if os.path.isfile(jar):
        need = from_server_jar(jar)
        if need:
            return need
    libs = os.path.join(pack, "libraries", "net", "minecraft", "server")
    if os.path.isdir(libs):
        for name in sorted(os.listdir(libs)):
            if re.fullmatch(r"[0-9]+\.[0-9]+(?:\.[0-9]+)?", name):
                return java_for(name)
    variables = os.path.join(pack, "variables.txt")
    if os.path.isfile(variables):
        with open(variables, errors="replace") as fh:
            for line in fh:
                match = re.match(r"\s*MINECRAFT_VERSION\s*=\s*[\"']?([0-9]+\.[0-9]+(?:\.[0-9]+)?)", line)
                if match:
                    return java_for(match.group(1))
    try:
        names = sorted(os.listdir(pack))
    except OSError:
        return None
    for name in names:
        if name.lower().endswith(".jar"):
            match = MC.search(name)
            if match:
                return java_for(match.group(1))
    return None

for name in sys.argv[2:]:
    need = required(os.path.join(root, name))
    print(f"{name}\t{need or '-'}")
PY
}

web_pack_row() {
	local file="$1"
	local indexed="$2"
	local name="$3"
	local need="${4:--}"
	local usage="${5:-}"
	local java port status cpu ram uptime curse=0

	java="$(get_java_version "$name")"
	port="$(get_port "$name")"
	if [[ -d "$MINECRAFT_ROOT/$name" ]]; then
		status="$(display_status "$name")"
		cpu="-"
		ram="-"
		uptime="-"
		if [[ "$status" != "stopped" && -n "$usage" ]] && pack_stays_inside "$name"; then
			IFS=$'\t' read -r cpu ram uptime <<<"$usage"
		fi
		if [[ -f "$MINECRAFT_ROOT/$name/.curseforge-id" ]]; then
			curse=1
		fi
	else
		status="stopped"
		cpu="-"
		ram="-"
		uptime="-"
	fi
	printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' \
		"$indexed" "$name" "$java" "$port" "$status" "$cpu" "$ram" "$uptime" "$curse" "$need" >>"$file"
}

web_json_packs() {
	local file name active enabled major
	local -A seen=() needs=() usage=()
	local -a others=()
	file="$(mktemp)"
	collect_pack_usage usage
	read_index
	while IFS= read -r name; do
		[[ -n "$name" ]] || continue
		[[ -n "${seen[$name]:-}" ]] && continue
		others+=("$name")
	done < <(all_modpack_names || true)
	while IFS=$'\t' read -r name major; do
		[[ -n "$name" ]] && needs["$name"]="$major"
	done < <(packs_required_java "${INDEX_ENTRIES[@]+"${INDEX_ENTRIES[@]}"}" "${others[@]+"${others[@]}"}" 2>/dev/null || true)
	for name in "${INDEX_ENTRIES[@]+"${INDEX_ENTRIES[@]}"}"; do
		[[ -n "$name" ]] || continue
		web_pack_row "$file" 1 "$name" "${needs[$name]:--}" "${usage[$name]:-}"
		seen["$name"]=1
	done
	for name in "${others[@]+"${others[@]}"}"; do
		[[ -n "${seen[$name]:-}" ]] && continue
		web_pack_row "$file" 0 "$name" "${needs[$name]:--}" "${usage[$name]:-}"
	done
	active="$(web_service_activity)"
	enabled="$(systemctl is-enabled "$SYSTEMD_SERVICE" 2>/dev/null || true)"
	[[ -n "$active" ]] || active="unknown"
	[[ -n "$enabled" ]] || enabled="unknown"
	local status=0
	python3 - "$file" "$active" "$enabled" <<'PY' || status=$?
import json, sys
rows = []
with open(sys.argv[1], encoding="utf-8") as fh:
    for line in fh:
        parts = line.rstrip("\n").split("\x1f")
        if len(parts) != 10:
            continue
        indexed, name, java, port, status, cpu, ram, uptime, curse, need = parts
        rows.append({
            "indexed": indexed == "1",
            "name": name,
            "java": java,
            "port": port,
            "status": status,
            "cpu": cpu,
            "ram": ram,
            "uptime": uptime,
            "curseforge": curse == "1",
            "java_need": need,
        })
print(json.dumps({
    "packs": rows,
    "service": {"active": sys.argv[2], "enabled": sys.argv[3]},
}))
PY
	rm -f "$file"
	return "$status"
}

# First line is "MODMAN_LOG <reset 0|1> <next offset>". The rest is log text.
# offset 0, or an offset past the end of the file, sends the last 200 lines.
# Any other offset sends only the bytes written after that point.
web_show_log() {
	local name="${1:-}"
	local offset="${2:-0}"
	local log size
	require_modpack "$name" || return 1
	if [[ ! -d "$MINECRAFT_ROOT/$name" ]]; then
		echo "Error: '$name' not found under $MINECRAFT_ROOT" >&2
		return 1
	fi
	if [[ ! "$offset" =~ ^[0-9]{1,18}$ ]]; then
		offset=0
	fi
	log="$MINECRAFT_ROOT/$name/logs/latest.log"
	if [[ ! -f "$log" ]]; then
		printf 'MODMAN_LOG 1 0\nNo log yet.\n'
		return 0
	fi
	size="$(stat -c '%s' "$log")"
	if (( offset == 0 || offset > size )); then
		printf 'MODMAN_LOG 1 %s\n' "$size"
		head -c "$size" "$log" | tail -n 200
		return 0
	fi
	printf 'MODMAN_LOG 0 %s\n' "$size"
	if (( offset < size )); then
		tail -c +$((offset + 1)) "$log" | head -c $((size - offset))
	fi
}

# screen's stuff command treats ^ and \ as escapes. Quote those so a
# console line is typed through as itself.
screen_stuff_escape() {
	printf '%s' "$1" | python3 -c 'import sys
out = []
for ch in sys.stdin.read():
    if ch == "\\":
        out.append("\\\\")
    elif ch == "^":
        out.append("\\136")
    else:
        out.append(ch)
sys.stdout.write("".join(out))'
}

web_send_command() {
	local name="${1:-}"
	local command="${2:-}"
	local session escaped
	require_modpack "$name" || return 1
	if [[ ! -d "$MINECRAFT_ROOT/$name" ]]; then
		echo "Error: '$name' not found under $MINECRAFT_ROOT" >&2
		return 1
	fi
	command="${command#"${command%%[![:space:]]*}"}"
	command="${command%"${command##*[![:space:]]}"}"
	if [[ "$command" == /* ]]; then
		command="${command#/}"
	fi
	if [[ -z "$command" ]]; then
		echo "Error: enter a command." >&2
		return 1
	fi
	if ((${#command} > 300)); then
		echo "Error: command is too long." >&2
		return 1
	fi
	if [[ "$command" == *$'\n'* || "$command" == *$'\r'* || "$command" =~ [[:cntrl:]] ]]; then
		echo "Error: command must be one line." >&2
		return 1
	fi
	if ! is_running "$name"; then
		echo "Error: '$name' is not running." >&2
		return 1
	fi
	escaped="$(screen_stuff_escape "$command")"
	session="$(screen_name "$name")"
	# ^M is screen's carriage return, which submits the line.
	if ! screen -S "$session" -p 0 -X stuff "${escaped}^M"; then
		echo "Error: could not send the command." >&2
		return 1
	fi
	echo "Sent to $name."
}

web_search() {
	local query="${1:-}"
	local key tsv file status=0
	query="${query#"${query%%[![:space:]]*}"}"
	query="${query%"${query##*[![:space:]]}"}"
	if [[ -z "$query" ]]; then
		echo "Error: enter a modpack name." >&2
		return 1
	fi
	key="$(read_curseforge_key)" || return 1
	tsv="$(cf_search_modpacks "$key" "$query")" || return 1
	file="$(mktemp)"
	printf '%s\n' "$tsv" >"$file"
	python3 - "$file" <<'PY' || status=$?
import json, sys
rows = []
with open(sys.argv[1], encoding="utf-8") as fh:
    for line in fh:
        line = line.rstrip("\n")
        if not line:
            continue
        parts = line.split("\t")
        while len(parts) < 4:
            parts.append("")
        mod_id, name, downloads, summary = parts[:4]
        rows.append({
            "id": mod_id,
            "name": name,
            "downloads": downloads,
            "summary": summary,
        })
print(json.dumps(rows))
PY
	rm -f "$file"
	return "$status"
}

web_install_modpack() {
	local mod_id="${1:-}"
	local key name
	if [[ ! "$mod_id" =~ ^[0-9]+$ ]]; then
		echo "Error: bad CurseForge project id." >&2
		return 1
	fi
	key="$(read_curseforge_key)" || return 1
	name="$(cf_mod_name "$key" "$mod_id")" || {
		echo "Error: could not read that CurseForge project." >&2
		return 1
	}
	install_chosen_modpack "$mod_id" "$name"
}

web_update() {
	local name="${1:-}"
	local world="${2:-}"
	local confirm="${3:-}"
	local delete_confirm="${4:-}"
	local mod_id="${5:-}"
	if ! valid_modpack_name "$name"; then
		echo "Error: '$name' is not a modpack name." >&2
		return 1
	fi
	if [[ "$confirm" != "yes" ]]; then
		echo "Error: type yes to update." >&2
		return 1
	fi
	case "$world" in
	keep)
		;;
	delete)
		if [[ "$delete_confirm" != "yes" ]]; then
			echo "Error: type yes to delete the world." >&2
			return 1
		fi
		;;
	*)
		echo "Error: world must be keep or delete." >&2
		return 1
		;;
	esac
	if [[ -n "$mod_id" && ! "$mod_id" =~ ^[0-9]+$ ]]; then
		echo "Error: bad CurseForge project id." >&2
		return 1
	fi
	MODMAN_YES=1 MODMAN_WORLD="$world" MODMAN_MOD_ID="$mod_id" update_modpack "$name"
}

web_run() {
	local cmd="${1:-}"
	shift || true
	case "$cmd" in
	start|stop|restart)
		if [[ -n "${1:-}" ]] && ! valid_modpack_name "$1"; then
			echo "Error: '$1' is not a modpack name." >&2
			return 1
		fi
		if [[ "${2:-}" == "agree" && -n "${1:-}" ]]; then
			MODMAN_EULA=agree
		fi
		case "$cmd" in
		start) start_servers "${1:-}" ;;
		stop) stop_servers "${1:-}" ;;
		restart) restart_servers "${1:-}" ;;
		esac
		;;
	enable)
		add_modpack "${1:-}"
		;;
	disable)
		remove_modpack "${1:-}"
		;;
	port)
		set_port "${1:-}" "${2:-}"
		;;
	uninstall)
		if ! valid_modpack_name "${1:-}"; then
			echo "Error: '${1:-}' is not a modpack name." >&2
			return 1
		fi
		if [[ "${2:-}" != "yes" ]]; then
			echo "Error: type yes to uninstall." >&2
			return 1
		fi
		MODMAN_YES=1 uninstall_modpack "$1"
		;;
	service)
		case "${1:-}" in
		status|start|stop|restart|enable|disable)
			service_control "$1"
			;;
		*)
			echo "Error: unknown service action '${1:-}'." >&2
			return 1
			;;
		esac
		;;
	*)
		echo "Error: unknown action '$cmd'." >&2
		return 1
		;;
	esac
}

web_call() {
	local op="${1:-}"
	shift || true
	case "$op" in
	packs) web_json_packs ;;
	log) web_show_log "${1:-}" "${2:-}" ;;
	command) web_send_command "${1:-}" "${2:-}" ;;
	search) web_search "${1:-}" ;;
	install) web_install_modpack "${1:-}" ;;
	update) web_update "${1:-}" "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
	run) web_run "$@" ;;
	*)
		echo "Error: unknown web call." >&2
		return 1
		;;
	esac
}

web_read_state() {
	WEB_PID=""
	WEB_PORT_SAVED=""
	[[ -f "$WEB_STATE_FILE" ]] || return 1
	local line key val
	WEB_HTTP_PORT_SAVED="$WEB_HTTP_PORT"
	while IFS= read -r line || [[ -n "$line" ]]; do
		key="${line%%=*}"
		val="${line#*=}"
		case "$key" in
		pid) WEB_PID="$val" ;;
		port) WEB_PORT_SAVED="$val" ;;
		http_port)
			if [[ "$val" =~ ^[0-9]+$ ]]; then
				WEB_HTTP_PORT_SAVED="$val"
			fi
			;;
		esac
	done <"$WEB_STATE_FILE"
	[[ "$WEB_PID" =~ ^[0-9]+$ ]] || return 1
	[[ "$WEB_PORT_SAVED" =~ ^[0-9]+$ ]] || WEB_PORT_SAVED="$WEB_PORT"
}

web_is_running() {
	web_read_state || return 1
	kill -0 "$WEB_PID" 2>/dev/null
}

web_print_links() {
	local https_port="$1"
	local http_port="${2:-$WEB_HTTP_PORT}"
	local ip domain="" lan_ip=""
	local -a ips=()
	if [[ -s "$WEB_DOMAIN_FILE" ]]; then
		domain="$(head -n 1 "$WEB_DOMAIN_FILE" | tr -d '[:space:]')"
	fi
	if [[ "$domain" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ && "$domain" == *.* ]]; then
		echo "https://${domain}/"
	fi
	mapfile -t ips < <(web_private_ips)
	for ip in "${ips[@]+"${ips[@]}"}"; do
		[[ "$ip" == 127.* ]] && continue
		echo "https://${ip}:${https_port}/"
		[[ -n "$lan_ip" ]] || lan_ip="$ip"
	done
	if [[ -z "$lan_ip" ]]; then
		echo "https://127.0.0.1:${https_port}/"
	else
		echo "On this machine: https://127.0.0.1:${https_port}/"
	fi
	echo "Certificate for other devices: http://${lan_ip:-127.0.0.1}:${http_port}/modman-ca.crt"
	if [[ -s "$WEB_CA_FILE" ]]; then
		echo "Check that its fingerprint matches before trusting it:"
		openssl x509 -in "$WEB_CA_FILE" -noout -fingerprint -sha256 2>/dev/null | sed 's/^.*=/  /' || true
	fi
}

# The local CA may only sign for these networks and names, so its key cannot
# be used to impersonate other sites. Public addresses use the domain instead.
WEB_CA_IP_RANGES=(
	127.0.0.0/255.0.0.0
	10.0.0.0/255.0.0.0
	172.16.0.0/255.240.0.0
	192.168.0.0/255.255.0.0
	100.64.0.0/255.192.0.0
)
WEB_CA_DNS_SUFFIXES=(localhost local lan home.arpa internal)

# IPv4 addresses of this computer inside WEB_CA_IP_RANGES, other than 127.x.
web_private_ips() {
	local ip a b
	while IFS= read -r ip; do
		[[ "$ip" =~ ^([0-9]+)\.([0-9]+)\.[0-9]+\.[0-9]+$ ]] || continue
		a="${BASH_REMATCH[1]}"
		b="${BASH_REMATCH[2]}"
		if ((a == 10)) || ((a == 172 && b >= 16 && b <= 31)) \
			|| ((a == 192 && b == 168)) || ((a == 100 && b >= 64 && b <= 127)); then
			printf '%s\n' "$ip"
		fi
	done < <(hostname -I 2>/dev/null | tr ' ' '\n')
}

# Host name when it falls under WEB_CA_DNS_SUFFIXES, or a single label.
web_local_hostname() {
	local name suffix
	name="$(hostname -f 2>/dev/null || true)"
	name="${name,,}"
	[[ "$name" =~ ^[a-z0-9.-]+$ && "$name" != "localhost" ]] || return 0
	if [[ "$name" != *.* ]]; then
		printf '%s' "$name"
		return 0
	fi
	for suffix in "${WEB_CA_DNS_SUFFIXES[@]}"; do
		if [[ "$name" == *".${suffix}" ]]; then
			printf '%s' "$name"
			return 0
		fi
	done
}

web_cert_names() {
	local san="DNS:localhost,IP:127.0.0.1" ip name
	while IFS= read -r ip; do
		san+=",IP:${ip}"
	done < <(web_private_ips)
	name="$(web_local_hostname)"
	if [[ -n "$name" ]]; then
		san+=",DNS:${name}"
	fi
	printf '%s' "$san"
}

web_ca_constraints() {
	local out="critical" range suffix name
	for range in "${WEB_CA_IP_RANGES[@]}"; do
		out+=",permitted;IP:${range}"
	done
	for suffix in "${WEB_CA_DNS_SUFFIXES[@]}"; do
		out+=",permitted;DNS:${suffix}"
	done
	name="$(web_local_hostname)"
	if [[ -n "$name" && "$name" != *.* ]]; then
		out+=",permitted;DNS:${name}"
	fi
	printf '%s' "$out"
}

web_cert_ok() {
	local text ip
	[[ -s "$WEB_CERT_FILE" && -s "$WEB_KEY_FILE" && -s "$WEB_CA_FILE" && -s "$WEB_CA_KEY_FILE" ]] || return 1
	openssl verify -CAfile "$WEB_CA_FILE" "$WEB_CERT_FILE" >/dev/null 2>&1 || return 1
	text="$(openssl x509 -in "$WEB_CERT_FILE" -noout -text 2>/dev/null || true)"
	[[ "$text" == *'CA:FALSE'* ]] || return 1
	[[ "$text" == *'TLS Web Server Authentication'* ]] || return 1
	[[ "$text" == *'IP Address:127.0.0.1'* ]] || return 1
	while IFS= read -r ip; do
		[[ "$text" == *"IP Address:${ip}"* ]] || return 1
	done < <(web_private_ips)
	return 0
}

web_ensure_ca() {
	local text not_before not_after
	if [[ -s "$WEB_CA_FILE" && -s "$WEB_CA_KEY_FILE" ]]; then
		text="$(openssl x509 -in "$WEB_CA_FILE" -noout -text 2>/dev/null || true)"
		# A CA made before name constraints is replaced, and so is its server cert.
		if [[ "$text" == *'CA:TRUE'* && "$text" == *'Name Constraints'* ]]; then
			return 0
		fi
		echo "Replacing the local https certificate with one limited to this network."
		echo "Devices that trusted the old modman certificate need to remove it and install the new one."
		rm -f "$WEB_CERT_FILE" "$WEB_KEY_FILE"
	fi
	not_before="$(date -u -d '2 days ago' +%Y%m%d%H%M%SZ)"
	not_after="$(date -u -d '10 years' +%Y%m%d%H%M%SZ)"
	umask 077
	if ! openssl req -x509 -newkey rsa:2048 -sha256 -nodes \
		-keyout "$WEB_CA_KEY_FILE" -out "$WEB_CA_FILE" \
		-not_before "$not_before" -not_after "$not_after" \
		-subj /CN=modman \
		-addext basicConstraints=critical,CA:TRUE \
		-addext keyUsage=critical,keyCertSign,cRLSign \
		-addext "nameConstraints=$(web_ca_constraints)" >/dev/null 2>&1; then
		rm -f "$WEB_CA_FILE" "$WEB_CA_KEY_FILE"
		echo "Error: could not create the https certificate." >&2
		return 1
	fi
	chmod 600 "$WEB_CA_KEY_FILE"
	chmod 644 "$WEB_CA_FILE"
}

web_ensure_cert() {
	local san cfg keytmp csrtmp certtmp serial not_before not_after
	if web_cert_ok; then
		return 0
	fi
	if ! command -v openssl >/dev/null 2>&1; then
		echo "Error: https needs openssl to make a certificate." >&2
		return 1
	fi
	web_ensure_ca || return 1
	san="$(web_cert_names)"
	cfg="$(mktemp)"
	keytmp="$(mktemp)"
	csrtmp="$(mktemp)"
	certtmp="$(mktemp)"
	serial="${cfg}.srl"
	not_before="$(date -u -d '2 days ago' +%Y%m%d%H%M%SZ)"
	not_after="$(date -u -d '390 days' +%Y%m%d%H%M%SZ)"
	cat >"$cfg" <<EOF
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = ${san}
EOF
	umask 077
	if ! openssl req -newkey rsa:2048 -sha256 -nodes \
		-keyout "$keytmp" -out "$csrtmp" \
		-subj /CN=modman >/dev/null 2>&1 \
		|| ! openssl x509 -req -in "$csrtmp" \
			-CA "$WEB_CA_FILE" -CAkey "$WEB_CA_KEY_FILE" -CAserial "$serial" -CAcreateserial \
			-out "$certtmp" -sha256 \
			-not_before "$not_before" -not_after "$not_after" \
			-extfile "$cfg" >/dev/null 2>&1; then
		rm -f "$cfg" "$keytmp" "$csrtmp" "$certtmp" "$serial"
		echo "Error: could not create the https certificate." >&2
		return 1
	fi
	rm -f "$cfg" "$csrtmp" "$serial"
	mv "$keytmp" "$WEB_KEY_FILE"
	mv "$certtmp" "$WEB_CERT_FILE"
	chmod 600 "$WEB_KEY_FILE"
	chmod 644 "$WEB_CERT_FILE"
}

# Ask sudo to trust the certificate on this computer. A browser on another
# computer still needs the certificate file from the http link.
web_trust_ca() {
	local dest="/usr/local/share/ca-certificates/modman-web.crt"
	if [[ -r /etc/ssl/certs/ca-certificates.crt ]] \
		&& openssl verify -CAfile /etc/ssl/certs/ca-certificates.crt "$WEB_CERT_FILE" >/dev/null 2>&1; then
		return 0
	fi
	echo "Trusting the https certificate on this computer."
	if command -v sudo >/dev/null 2>&1 \
		&& sudo bash -c 'cp "$1" "$2" && update-ca-certificates' bash "$WEB_CA_FILE" "$dest" >/dev/null; then
		return 0
	fi
	echo "This computer did not trust the certificate."
	echo "If the browser shows a certificate error and no way to continue, click the page and type thisisunsafe."
}

web_write_helper() {
	local helper_tmp wrote=0
	helper_tmp="$(mktemp "${TMPDIR:-/tmp}/modman-web.XXXXXX")"
	cat >"$helper_tmp" <<EOF
#!/usr/bin/env bash
set -euo pipefail
hash_file=$(printf '%q' "$WEB_HASH_FILE")
cert_file=$(printf '%q' "$WEB_CERT_FILE")
key_file=$(printf '%q' "$WEB_KEY_FILE")
modman_bin=$(printf '%q' "${SCRIPT_DIR}/modman")
web_py=$(printf '%q' "$WEB_PY")
state_file=$(printf '%q' "$WEB_STATE_FILE")
port=$WEB_PORT
http_port=$WEB_HTTP_PORT
if [[ ! -s "\$hash_file" ]]; then
	echo "Error: missing webpage password hash: \$hash_file" >&2
	echo "Run web install to set it." >&2
	exit 1
fi
if [[ ! -s "\$cert_file" || ! -s "\$key_file" ]]; then
	echo "Error: missing https certificate." >&2
	echo "Run web start so modman can create one." >&2
	exit 1
fi
passfile="\$(mktemp)"
chmod 600 "\$passfile"
cp "\$hash_file" "\$passfile"
printf 'pid=%s\\nport=%s\\nhttp_port=%s\\n' "\$\$" "\$port" "\$http_port" >"\$state_file"
MODMAN_WEB_CERT="\$cert_file" \\
	MODMAN_WEB_KEY="\$key_file" \\
	MODMAN_WEB_PASSWORD_FILE="\$passfile" \\
	MODMAN_BIN="\$modman_bin" \\
	MODMAN_WEB_PORT="\$port" \\
	MODMAN_WEB_HTTP_PORT="\$http_port" \\
	exec python3 "\$web_py"
EOF
	chmod 755 "$helper_tmp"
	if install_system_file "$helper_tmp" "$WEB_SYSTEMD_HELPER"; then
		wrote=1
	fi
	rm -f "$helper_tmp"
	((wrote))
}

web_save_hash() {
	local hash="$1" old_umask
	old_umask="$(umask)"
	umask 077
	if ! printf '%s\n' "$hash" >"$WEB_HASH_FILE"; then
		umask "$old_umask"
		return 1
	fi
	chmod 600 "$WEB_HASH_FILE"
	umask "$old_umask"
}

# "scrypt$n$r$p$salt$digest". A bare 64-digit SHA-256 hash is the old format.
WEB_HASH_RE='^scrypt\$[0-9]+\$[0-9]+\$[0-9]+\$[0-9a-f]{32}\$[0-9a-f]{64}$'
WEB_LEGACY_HASH_RE='^[0-9a-f]{64}$'
WEB_PASSWORD_MIN=4

# Prompt for the webpage password and store its hash in WEB_PASSWORD_HASH.
web_prompt_hash() {
	local password again
	if ! IFS= read -r -s -p "Password for the webpage (at least ${WEB_PASSWORD_MIN} characters): " password; then
		echo
		return 1
	fi
	echo
	if ((${#password} < WEB_PASSWORD_MIN)); then
		unset password
		echo "Error: the password must be at least ${WEB_PASSWORD_MIN} characters." >&2
		return 1
	fi
	if ! IFS= read -r -s -p "Type it again: " again; then
		unset password
		echo
		return 1
	fi
	echo
	if [[ "$password" != "$again" ]]; then
		unset password again
		echo "Error: the passwords do not match." >&2
		return 1
	fi
	unset again
	if ! WEB_PASSWORD_HASH="$(printf '%s' "$password" | python3 -c 'import hashlib, os, sys
n, r, p = 2 ** 14, 8, 1
salt = os.urandom(16)
digest = hashlib.scrypt(sys.stdin.buffer.read(), salt=salt, n=n, r=r, p=p, dklen=32)
sys.stdout.write(f"scrypt${n}${r}${p}${salt.hex()}${digest.hex()}")')"; then
		unset password WEB_PASSWORD_HASH
		echo "Error: could not hash the password." >&2
		return 1
	fi
	unset password
	if [[ ! "$WEB_PASSWORD_HASH" =~ $WEB_HASH_RE ]]; then
		unset WEB_PASSWORD_HASH
		echo "Error: could not hash the password." >&2
		return 1
	fi
}

# Read the saved hash into WEB_PASSWORD_HASH.
web_require_hash() {
	local hash
	if [[ ! -s "$WEB_HASH_FILE" ]]; then
		echo "Error: no webpage password is set. Run web password first." >&2
		return 1
	fi
	hash="$(tr -d '[:space:]' <"$WEB_HASH_FILE")"
	if [[ "$hash" =~ $WEB_LEGACY_HASH_RE ]]; then
		echo "Warning: the saved webpage password uses an old, weak hash. Run web password to replace it." >&2
	elif [[ ! "$hash" =~ $WEB_HASH_RE ]]; then
		echo "Error: the saved webpage password is invalid. Run web password." >&2
		return 1
	fi
	WEB_PASSWORD_HASH="$hash"
}

web_start() {
	local passfile pid i
	if web_is_running; then
		echo "The webpage is already running."
		web_print_links "$WEB_PORT_SAVED" "$WEB_HTTP_PORT_SAVED"
		return 0
	fi
	if web_unit_active; then
		echo "The webpage is already running."
		web_print_links "$WEB_PORT" "$WEB_HTTP_PORT"
		return 0
	fi
	rm -f "$WEB_STATE_FILE"
	if ! command -v python3 >/dev/null 2>&1; then
		echo "Error: the webpage needs python3." >&2
		return 1
	fi
	if [[ ! -f "$WEB_PY" ]]; then
		echo "Error: missing $WEB_PY" >&2
		return 1
	fi
	web_ensure_cert || return 1
	web_trust_ca || true
	web_require_hash || return 1
	if [[ -f "$WEB_SYSTEMD_UNIT" ]]; then
		unset WEB_PASSWORD_HASH
		echo "Starting $WEB_SYSTEMD_SERVICE..."
		web_write_helper || return 1
		run_systemctl start "$WEB_SYSTEMD_SERVICE" || return 1
		for i in $(seq 1 50); do
			if web_is_running; then
				echo "The webpage is running."
				web_print_links "$WEB_PORT_SAVED" "$WEB_HTTP_PORT_SAVED"
				return 0
			fi
			sleep 0.1
		done
		echo "Error: the webpage did not start in time." >&2
		return 1
	fi
	passfile="$(mktemp)"
	chmod 600 "$passfile"
	printf '%s' "$WEB_PASSWORD_HASH" >"$passfile"
	unset WEB_PASSWORD_HASH
	: >"$WEB_LOG_FILE"
	# The file holds the password hash, not the password, and not on the command line.
	MODMAN_WEB_CERT="$WEB_CERT_FILE" \
		MODMAN_WEB_KEY="$WEB_KEY_FILE" \
		MODMAN_WEB_PASSWORD_FILE="$passfile" \
		MODMAN_BIN="${SCRIPT_DIR}/modman" \
		MODMAN_WEB_PORT="$WEB_PORT" \
		MODMAN_WEB_HTTP_PORT="$WEB_HTTP_PORT" \
		nohup python3 "$WEB_PY" >>"$WEB_LOG_FILE" 2>&1 </dev/null &
	pid=$!
	disown "$pid" 2>/dev/null || true
	printf 'pid=%s\nport=%s\nhttp_port=%s\n' "$pid" "$WEB_PORT" "$WEB_HTTP_PORT" >"$WEB_STATE_FILE"
	for i in $(seq 1 50); do
		if grep -q '^listening ' "$WEB_LOG_FILE" 2>/dev/null; then
			rm -f "$passfile"
			echo "The webpage is running."
			web_print_links "$WEB_PORT" "$WEB_HTTP_PORT"
			return 0
		fi
		if ! kill -0 "$pid" 2>/dev/null; then
			rm -f "$passfile" "$WEB_STATE_FILE"
			echo "Error: the webpage failed to start." >&2
			if [[ -s "$WEB_LOG_FILE" ]]; then
				cat "$WEB_LOG_FILE" >&2
			fi
			return 1
		fi
		sleep 0.1
	done
	kill "$pid" 2>/dev/null || true
	rm -f "$passfile" "$WEB_STATE_FILE"
	echo "Error: the webpage did not start in time. See $WEB_LOG_FILE" >&2
	return 1
}

web_unit_active() {
	[[ "$(systemctl is-active "$WEB_SYSTEMD_SERVICE" 2>/dev/null || true)" == "active" ]]
}

web_stop() {
	local i stopped=0
	if web_unit_active; then
		echo "Stopping $WEB_SYSTEMD_SERVICE..."
		run_systemctl stop "$WEB_SYSTEMD_SERVICE" || return 1
		stopped=1
	fi
	if ! web_is_running; then
		rm -f "$WEB_STATE_FILE"
		if ((stopped)); then
			echo "Stopped the webpage."
			return 0
		fi
		echo "The webpage is not running."
		return 0
	fi
	kill "$WEB_PID" 2>/dev/null || true
	for i in $(seq 1 25); do
		kill -0 "$WEB_PID" 2>/dev/null || break
		sleep 0.2
	done
	if kill -0 "$WEB_PID" 2>/dev/null; then
		kill -9 "$WEB_PID" 2>/dev/null || true
	fi
	rm -f "$WEB_STATE_FILE"
	echo "Stopped the webpage."
}

web_restart() {
	if web_is_running || web_unit_active; then
		web_stop || return 1
	fi
	web_start
}

web_password() {
	web_prompt_hash || return 1
	if ! web_save_hash "$WEB_PASSWORD_HASH"; then
		unset WEB_PASSWORD_HASH
		echo "Error: failed to write $WEB_HASH_FILE" >&2
		return 1
	fi
	unset WEB_PASSWORD_HASH
	echo "Webpage password updated."
	if web_is_running || web_unit_active; then
		echo "Restarting the webpage so the new password is used."
		web_restart || return 1
	fi
}

web_status() {
	if web_is_running; then
		echo "The webpage is running."
		web_print_links "$WEB_PORT_SAVED" "$WEB_HTTP_PORT_SAVED"
		return 0
	fi
	rm -f "$WEB_STATE_FILE"
	echo "The webpage is not running."
}

web_install() {
	local user unit_tmp
	if ! command -v python3 >/dev/null 2>&1; then
		echo "Error: the webpage needs python3." >&2
		return 1
	fi
	if ! command -v systemctl >/dev/null 2>&1; then
		echo "Error: systemctl is not available." >&2
		return 1
	fi
	if [[ ! -f "$WEB_PY" ]]; then
		echo "Error: missing $WEB_PY" >&2
		return 1
	fi
	user="$(service_user "$WEB_SYSTEMD_SERVICE")" || return 1

	echo "The boot service keeps a hash of this password. The password itself is not stored."
	web_prompt_hash || return 1
	if ! web_save_hash "$WEB_PASSWORD_HASH"; then
		unset WEB_PASSWORD_HASH
		echo "Error: failed to write $WEB_HASH_FILE" >&2
		return 1
	fi
	unset WEB_PASSWORD_HASH

	echo "Installing $WEB_SYSTEMD_SERVICE for user $user..."
	unit_tmp="$(mktemp "${TMPDIR:-/tmp}/modman-web.service.XXXXXX")"
	# shellcheck disable=SC2064
	trap "rm -f $(printf '%q' "$unit_tmp")" RETURN

	cat >"$unit_tmp" <<EOF
[Unit]
Description=modman control page
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${user}
WorkingDirectory=${ROOT_DIR}
ExecStart=${WEB_SYSTEMD_HELPER}

[Install]
WantedBy=multi-user.target
EOF

	if ! web_write_helper; then
		return 1
	fi
	if ! install_system_file "$unit_tmp" "$WEB_SYSTEMD_UNIT"; then
		return 1
	fi
	echo "Installed $WEB_SYSTEMD_UNIT (User=$user)."
	echo "Installed $WEB_SYSTEMD_HELPER."
	run_systemctl daemon-reload || return 1
	echo "$WEB_SYSTEMD_SERVICE installed. It was not enabled or started."
	echo "Run 'web enable' to start it at boot, or 'web start' to start it now."
}

web_enable() {
	if [[ ! -f "$WEB_SYSTEMD_UNIT" ]]; then
		echo "Error: $WEB_SYSTEMD_SERVICE is not installed. Run web install first." >&2
		return 1
	fi
	web_require_hash || return 1
	unset WEB_PASSWORD_HASH
	web_ensure_cert || return 1
	web_trust_ca || true
	web_write_helper || return 1
	echo "Enabling $WEB_SYSTEMD_SERVICE to start at boot..."
	run_systemctl enable "$WEB_SYSTEMD_SERVICE" || return 1
	echo "$WEB_SYSTEMD_SERVICE enabled. It was not started."
}

web_disable() {
	echo "Disabling $WEB_SYSTEMD_SERVICE from starting at boot..."
	run_systemctl disable "$WEB_SYSTEMD_SERVICE" || return 1
	echo "$WEB_SYSTEMD_SERVICE disabled. The webpage was left up."
}

web_control() {
	local action="${1:-}"
	if (($# > 1)); then
		echo "Error: 'web' takes one action: start, stop, restart, status, password, enable, disable, or install." >&2
		return 1
	fi
	case "$action" in
	start)
		web_start
		;;
	stop)
		web_stop
		;;
	restart)
		web_restart
		;;
	status)
		web_status
		;;
	password|pswd)
		web_password
		;;
	enable)
		web_enable
		;;
	disable)
		web_disable
		;;
	install)
		web_install
		;;
	"")
		echo "Error: 'web' requires start, stop, restart, status, password, enable, disable, or install." >&2
		return 1
		;;
	*)
		echo "Error: unknown web action '$action'." >&2
		return 1
		;;
	esac
}

dispatch() {
	if (($# == 0)); then
		return 0
	fi

	local cmd="$1"
	shift

	case "$cmd" in
		exit)
			return 2
			;;
		help)
			usage
			;;
		list)
			list_index
			;;
		status)
			show_status "${1:-}" || return 1
			;;
		usage)
			show_usage "${1:-}" || return 1
			;;
		start)
			start_servers "${1:-}" || return 1
			;;
		stop)
			stop_servers "${1:-}" || return 1
			;;
		restart)
			restart_servers "${1:-}" || return 1
			;;
		join)
			require_arg "$cmd" "${1:-}" || return 1
			join_screen "$1" || return 1
			;;
		service)
			service_control "${1:-}" || return 1
			;;
		install)
			install_modpack || return 1
			;;
		update)
			require_arg "$cmd" "${1:-}" || return 1
			update_modpack "$1" || return 1
			;;
		enable)
			require_arg "$cmd" "${1:-}" || return 1
			add_modpack "$1" || return 1
			;;
		disable)
			require_arg "$cmd" "${1:-}" || return 1
			remove_modpack "$1" || return 1
			;;
		uninstall)
			require_arg "$cmd" "${1:-}" || return 1
			uninstall_modpack "$1" || return 1
			;;
		rename|mv)
			require_two_args "$cmd" "${1:-}" "${2:-}" || return 1
			rename_modpack "$1" "$2" || return 1
			;;
		port)
			require_two_args "$cmd" "${1:-}" "${2:-}" || return 1
			set_port "$1" "$2" || return 1
			;;
		web)
			web_control "$@" || return 1
			;;
		*)
			echo "Error: unknown command '$cmd'. Type help for commands." >&2
			return 1
			;;
	esac
}

all_modpack_names() {
	local dir name
	for dir in "$MINECRAFT_ROOT"/*/; do
		[[ -d "$dir" ]] || continue
		name="$(basename "$dir")"
		[[ "$name" == *.bak ]] && continue
		printf '%s\n' "$name"
	done
}

available_modpack_names() {
	read_index
	local name
	while IFS= read -r name; do
		[[ -n "$name" ]] || continue
		in_index "$name" && continue
		printf '%s\n' "$name"
	done < <(all_modpack_names)
}

# Tab completion for read -e. Programmable `complete -F` does not run under
# read -e, so we bind Tab to a handler that edits READLINE_LINE / READLINE_POINT.
_ci_matches() {
	local cur="$1"
	local word
	shift
	for word in "$@"; do
		[[ -n "$word" ]] || continue
		[[ "${word,,}" == "${cur,,}"* ]] && printf '%s\n' "$word"
	done
}

_repl_candidates() {
	local cmd="$1"
	local cword="$2"
	local cur="$3"
	local -a words=()

	if ((cword == 0)); then
		_ci_matches "$cur" list status usage start stop restart join service install update enable disable uninstall rename mv port web help exit
		return 0
	fi

	case "$cmd" in
		service)
			if ((cword == 1)); then
				_ci_matches "$cur" status start stop restart enable disable install
			fi
			;;
		web)
			if ((cword == 1)); then
				_ci_matches "$cur" start stop restart status password pswd enable disable install
			fi
			;;
		enable)
			if ((cword == 1)); then
				mapfile -t words < <(available_modpack_names || true)
				_ci_matches "$cur" ${words[@]+"${words[@]}"}
			fi
			;;
		disable)
			if ((cword == 1)); then
				read_index
				_ci_matches "$cur" ${INDEX_ENTRIES[@]+"${INDEX_ENTRIES[@]}"}
			fi
			;;
		uninstall|update)
			if ((cword == 1)); then
				mapfile -t words < <(all_modpack_names || true)
				_ci_matches "$cur" ${words[@]+"${words[@]}"}
			fi
			;;
		rename|mv|port)
			if ((cword == 1)); then
				mapfile -t words < <(all_modpack_names || true)
				_ci_matches "$cur" ${words[@]+"${words[@]}"}
			fi
			;;
		status|usage|start|stop|restart|join)
			if ((cword == 1)); then
				read_index
				_ci_matches "$cur" ${INDEX_ENTRIES[@]+"${INDEX_ENTRIES[@]}"}
			fi
			;;
	esac
	return 0
}

_repl_common_prefix() {
	local prefix="$1"
	local word
	shift
	for word in "$@"; do
		while [[ "$word" != "$prefix"* ]]; do
			prefix="${prefix%?}"
			[[ -z "$prefix" ]] && break
		done
	done
	printf '%s' "$prefix"
}

_repl_tab_complete() {
	local line="${READLINE_LINE-}"
	local point="${READLINE_POINT-0}"
	local before="${line:0:point}"
	local after="${line:point}"
	local -a words=()
	local cur="" cword=0

	# shellcheck disable=SC2206
	words=($before)
	if [[ -z "$before" || "$before" =~ [[:space:]]$ ]]; then
		cur=""
		cword=${#words[@]}
	else
		cur="${words[-1]}"
		cword=$((${#words[@]} - 1))
	fi

	local cmd="${words[0]-}"
	local -a matches=()
	mapfile -t matches < <(_repl_candidates "$cmd" "$cword" "$cur")
	((${#matches[@]})) || return 0

	local completed
	if ((${#matches[@]} == 1)); then
		completed="${matches[0]} "
	else
		local -a lower=()
		local m prefix
		for m in "${matches[@]}"; do
			lower+=("${m,,}")
		done
		prefix="$(_repl_common_prefix "${lower[0]}" "${lower[@]:1}")"
		completed="${matches[0]:0:${#prefix}}"
		if [[ -z "$prefix" || "${completed,,}" == "${cur,,}" ]]; then
			# List matches; readline redisplays the prompt/line after bind -x.
			printf '\n%s\n' "${matches[*]}"
			return 0
		fi
	fi

	local prefix_before="$before"
	if [[ -n "$cur" ]]; then
		prefix_before="${before:0:$((${#before} - ${#cur}))}"
	fi
	READLINE_LINE="${prefix_before}${completed}${after}"
	READLINE_POINT=$((${#prefix_before} + ${#completed}))
}

setup_repl_completion() {
	bind -x '"\t": _repl_tab_complete' 2>/dev/null || true
}

repl() {
	echo "Modpack manager. Type help for commands, exit to leave."
	local line
	local -a args

	# Enable readline history for up/down arrow recall across sessions.
	set -o history
	HISTFILE="$HISTORY_FILE"
	HISTSIZE=1000
	HISTFILESIZE=1000
	HISTCONTROL=ignoredups
	history -r "$HISTFILE" 2>/dev/null || true
	setup_repl_completion

	while true; do
		if ! read -r -e -p "modman> " line; then
			echo
			echo "Bye."
			history -w "$HISTFILE" 2>/dev/null || true
			break
		fi

		# Trim surrounding whitespace.
		line="${line#"${line%%[![:space:]]*}"}"
		line="${line%"${line##*[![:space:]]}"}"
		[[ -z "$line" ]] && continue

		history -s "$line"
		history -a "$HISTFILE" 2>/dev/null || true

		# shellcheck disable=SC2206
		args=($line)
		set +e
		dispatch "${args[@]}"
		local status=$?
		set -e

		if ((status == 2)); then
			echo "Bye."
			history -w "$HISTFILE" 2>/dev/null || true
			break
		fi
	done
}

if [[ "${1:-}" == "--web-call" ]]; then
	shift
	MODMAN_WEB_CALL=1
	web_call "$@"
	exit $?
fi

if [[ "${1:-}" == "--web" || "${1:-}" == "-w" ]]; then
	shift
	web_control "$@"
	exit $?
fi

main() {
	if (($# > 0)); then
		echo "Error: this script is interactive. Run it with no arguments, then type commands at the prompt." >&2
		echo "Example: $(basename "$0")" >&2
		exit 1
	fi
	repl
}

main "$@"
